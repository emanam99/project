AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SEO files harus dilayani sebagai file asli, bukan fallback SPA
  RewriteCond %{REQUEST_URI} ^/(robots\.txt|sitemap\.xml)$ [NC]
  RewriteRule ^ - [L]

  # Jika request bukan file/folder asli, arahkan ke SPA entry.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Entry HTML & SW harus selalu dicek ulang ke server — hindari index.html lawas yang mereferensi chunk hash usang
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://alutsmani.id https://*.alutsmani.id https://alutsmani.my.id https://*.alutsmani.my.id https://gambar.alutsmani.id; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://alutsmani.id https://*.alutsmani.id https://alutsmani.my.id https://*.alutsmani.my.id https://fonts.googleapis.com https://fonts.gstatic.com ws: wss:; manifest-src 'self'; worker-src 'self' blob:; frame-src 'none'; form-action 'self'; upgrade-insecure-requests"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://alutsmani.id https://*.alutsmani.id https://alutsmani.my.id https://*.alutsmani.my.id https://gambar.alutsmani.id; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://alutsmani.id https://*.alutsmani.id https://alutsmani.my.id https://*.alutsmani.my.id https://fonts.googleapis.com https://fonts.gstatic.com ws: wss:; manifest-src 'self'; worker-src 'self' blob:; frame-src 'none'; form-action 'self'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  <Files index.html>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </Files>
  <Files sw.js>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </Files>
</IfModule>

# Jaga fallback 404 agar tetap masuk aplikasi.
ErrorDocument 404 /index.html
