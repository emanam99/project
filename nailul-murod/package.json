{
  "name": "nailul-murod",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "twa:merge": "cmd /c \"cd /d twa-playstore && bubblewrap merge\"",
    "twa:update": "cmd /c \"cd /d twa-playstore && bubblewrap update --manifest=./twa-manifest.json --directory=.\"",
    "twa:build": "cmd /c \"cd /d twa-playstore && bubblewrap build --manifest=./twa-manifest.json --directory=.\"",
    "twa:validate": "bubblewrap validate --url=https://nailul-murod.alutsmani.id/",
    "twa:preflight": "node scripts/twa-preflight.mjs"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  }
}
