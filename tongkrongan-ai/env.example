# ===========================================
# Tongkrongan AI - Environment Configuration
# ===========================================

# Applicaton
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Tongkrongan AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tongkrongan_ai?schema=public"

# Socket.IO Server
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# DeepSeek AI API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# AI Configuration
AI_RESPONSE_MIN_DELAY=3000
AI_RESPONSE_MAX_DELAY=15000
AI_TYPING_SPEED_MIN=50
AI_TYPING_SPEED_MAX=150
AI_MEMORY_SIZE=50
AI_COOLDOWN_MIN=10000
AI_COOLDOWN_MAX=60000
AI_THINKING_MIN=2000
AI_THINKING_MAX=8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Redis (optional, for production)
REDIS_URL=redis://localhost:6379

# Docker
DOCKER_ENV=false
