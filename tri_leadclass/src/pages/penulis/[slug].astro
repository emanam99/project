---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {
  formatContributorName,
  getArticlesByContributor,
  getContributorBySlug,
  getContributorPhoto,
} from '../../lib/contributors.ts';
import { mediaUrl } from '../../lib/uploads.ts';

const { slug } = Astro.params;
const contributor = slug ? getContributorBySlug(slug) : undefined;

if (!contributor) {
  return new Response('Penulis tidak ditemukan', { status: 404 });
}

const articles = getArticlesByContributor(contributor.id);

function photoSrc(): string {
  const p = getContributorPhoto(contributor);
  if (p?.startsWith('uploads/')) return mediaUrl(p) ?? '/icon/icon96.png';
  if (p?.startsWith('http')) return p;
  return '/icon/icon96.png';
}

function articleImage(img: string | null): string {
  if (!img) return '/icon/icon512.png';
  if (img.startsWith('/api/media/')) return img;
  if (img.startsWith('http')) return img;
  return img;
}
---

<Layout title={`${formatContributorName(contributor)} — Penulis TRI_LEADCLASS`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/penulis" class="flex items-center text-sm font-medium text-gray-500 hover:text-emerald-700 mb-8 transition-colors w-fit">
      <Icon name="arrow-left" size={16} class="mr-2" /> Semua Penulis
    </a>

    <div class="flex flex-col sm:flex-row items-start gap-6 mb-12 pb-8 border-b border-gray-200">
      <img src={photoSrc()} alt="" class="h-28 w-28 rounded-2xl object-cover ring-4 ring-emerald-50 shadow-sm" />
      <div>
        <h1 class="text-3xl md:text-4xl font-serif font-black text-slate-900 leading-tight">
          {formatContributorName(contributor)}
        </h1>
        {contributor.position_status && (
          <p class="text-emerald-700 font-medium mt-2">{contributor.position_status}</p>
        )}
        {contributor.institution && <p class="text-gray-600 mt-1">{contributor.institution}</p>}
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
          {contributor.email && <span>{contributor.email}</span>}
          {contributor.phone && <span>{contributor.phone}</span>}
          {contributor.id_number && <span>{contributor.id_number}</span>}
        </div>
      </div>
    </div>

    <h2 class="text-xl font-serif font-bold text-slate-900 mb-6">
      Artikel ({articles.length})
    </h2>

    {
      articles.length === 0 ? (
        <p class="text-gray-500">Belum ada artikel terbit.</p>
      ) : (
        <ul class="space-y-4">
          {
            articles.map((a) => (
              <li>
                <a
                  href={`/artikel/${a.slug}`}
                  class="flex gap-4 p-4 rounded-xl border border-gray-100 hover:border-emerald-200 hover:bg-emerald-50/30 transition-all group"
                >
                  <img
                    src={articleImage(a.image)}
                    alt=""
                    class="hidden sm:block h-20 w-28 rounded-lg object-cover shrink-0"
                  />
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                      {a.category_name && (
                        <span class="text-[10px] font-bold uppercase text-emerald-700 tracking-wider">
                          {a.category_name}
                        </span>
                      )}
                      <span class:list={[
                        'text-[10px] font-bold uppercase px-2 py-0.5 rounded-full',
                        a.is_primary ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600',
                      ]}>
                        {a.is_primary ? 'Penulis utama' : `Penulis ${a.sort_order + 1}`}
                      </span>
                    </div>
                    <p class="font-serif font-bold text-slate-900 group-hover:text-emerald-800 transition-colors leading-snug">
                      {a.title}
                    </p>
                    {a.excerpt && <p class="text-sm text-gray-500 mt-1 line-clamp-2">{a.excerpt}</p>}
                    {a.published_at && (
                      <p class="text-xs text-gray-400 mt-2">{a.published_at}</p>
                    )}
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      )
    }
  </div>
</Layout>
