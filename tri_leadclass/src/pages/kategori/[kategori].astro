---
import Layout from '../../layouts/Layout.astro';
import StandardArticle from '../../components/StandardArticle.astro';
import { getArticlesByCategory, getCategoryBySlug } from '../../lib/articles.ts';

const { kategori } = Astro.params;
const category = kategori ? getCategoryBySlug(kategori) : undefined;

if (!category) {
  return new Response('Kategori tidak ditemukan', { status: 404 });
}

const articles = getArticlesByCategory(category.slug);
---

<Layout title={`${category.name} — TRI_LEADCLASS`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12 border-b border-gray-200 pb-8">
      <p class="text-sm font-bold text-emerald-700 uppercase tracking-wider mb-2">Kategori</p>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-slate-900">{category.name}</h1>
      <p class="text-gray-500 mt-3">{articles.length} artikel dalam kategori ini.</p>
    </header>

    {
      articles.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {articles.map((article) => <StandardArticle article={article} />)}
        </div>
      ) : (
        <p class="text-gray-500">Belum ada artikel yang diterbitkan pada kategori ini.</p>
      )
    }
  </div>
</Layout>
