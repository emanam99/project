---
import AuthorLayout from '../../layouts/AuthorLayout.astro';
import GoogleLoginButton from '../../components/GoogleLoginButton.astro';
import ManuscriptAuthors from '../../components/manuscript/ManuscriptAuthors.astro';
import { getAllCategories } from '../../lib/articles.ts';
import { getUserAuthorProfile } from '../../lib/contributors.ts';
import { portalRoute } from '../../lib/portal-urls.ts';

const user = Astro.locals.user;
const onPenulis = Astro.locals.isPenulisHost;
const categories = getAllCategories();
const profile = user ? getUserAuthorProfile(user.id) : undefined;
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
const kirimPath = portalRoute('kirimNaskah', onPenulis);
---

<AuthorLayout title="Kirim Naskah — TRI_LEADCLASS" bare={!user}>
  <div class:list={['max-w-3xl mx-auto px-4 sm:px-6 lg:px-8', user ? 'py-2' : 'py-16']}>
    {
      !user ? (
        <>
          <p class="text-sm font-bold text-emerald-700 uppercase tracking-wider mb-2">Portal Penulis</p>
          <h1 class="text-4xl md:text-5xl font-serif font-black text-slate-900 mb-6">Kirim Naskah</h1>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Untuk mengirim naskah, silakan masuk dengan akun Google terlebih dahulu. Prosesnya cepat — cukup satu klik.
          </p>

          {error && (
            <div class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg">
              {decodeURIComponent(error)}
            </div>
          )}

          <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-8 text-center mb-10">
            <p class="text-gray-700 mb-6">Masuk dengan Google untuk melanjutkan pengajuan naskah.</p>
            <GoogleLoginButton returnTo={portalRoute('kirimNaskah', onPenulis)} />
          </div>

          <ol class="space-y-4 text-gray-600 text-sm">
            <li>1. Siapkan naskah (maks. 8.000 kata, sitasi APA edisi ke-7).</li>
            <li>2. Sertakan abstrak 200–250 kata + 3–5 kata kunci (ID & EN).</li>
            <li>3. Unggah file Word (.doc / .docx) dan gambar sampul setelah login.</li>
          </ol>
        </>
      ) : (
        <>
          {success && (
            <div class="mb-6 p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-lg">
              Naskah berhasil dikirim! Tim redaksi akan meninjau dalam 7 hari kerja.{' '}
              <a href={portalRoute('home', onPenulis)} class="underline font-semibold">Lihat dashboard</a>
            </div>
          )}

          <ManuscriptAuthors user={user} profile={profile} />

          <form id="submit-form" class="space-y-5 mb-12" enctype="multipart/form-data">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1 portal-text-title">Judul Naskah *</label>
              <input type="text" name="title" required minlength="10" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" placeholder="Judul lengkap naskah riset" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1 portal-text-title">Abstrak *</label>
              <textarea name="abstract" required minlength="50" rows="5" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" placeholder="Abstrak 200–250 kata..." />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1 portal-text-title">Kata Kunci</label>
              <input type="text" name="keywords" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" placeholder="Pisahkan dengan koma" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1 portal-text-title">Kategori</label>
              <select name="category" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500">
                <option value="">— Pilih kategori —</option>
                {categories.map((c) => <option value={c.name}>{c.name}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1 portal-text-title">Gambar Sampul Artikel</label>
              <p class="text-xs text-gray-400 mb-2">Tampil di beranda & halaman artikel jika naskah diterbitkan (JPG/PNG/WebP, maks. 5 MB)</p>
              <input type="file" name="cover_image" accept="image/jpeg,image/png,image/webp" data-photo-crop="cover" class="w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-emerald-50 file:text-emerald-700 file:font-semibold hover:file:bg-emerald-100" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1 portal-text-title">File Naskah Word * <span class="font-normal text-gray-400">(.doc / .docx, maks. 10 MB)</span></label>
              <input type="file" name="file" required accept=".doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-emerald-50 file:text-emerald-700 file:font-semibold hover:file:bg-emerald-100" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1 portal-text-title">Catatan untuk Redaksi</label>
              <textarea name="author_notes" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500" placeholder="Opsional" />
            </div>
            <p class="text-xs text-red-600 hidden" id="form-error"></p>
            <button type="submit" id="submit-btn" class="w-full bg-emerald-700 text-white font-semibold py-3 rounded-full hover:bg-emerald-800 transition-colors shadow-sm disabled:opacity-60">
              Kirim Naskah
            </button>
          </form>
        </>
      )
    }
  </div>
</AuthorLayout>

<script define:vars={{ kirimPath }}>
  const form = document.getElementById('submit-form');
  const errEl = document.getElementById('form-error');
  const btn = document.getElementById('submit-btn');

  const ALLOWED = ['.doc', '.docx'];

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !form) return;

    const helpers = window.__manuscriptAuthors;

    if (!helpers) {
      if (errEl) {
        errEl.textContent = 'Form penulis belum siap. Muat ulang halaman.';
        errEl.classList.remove('hidden');
      }
      return;
    }

    const primary = helpers.getPrimary();
    if (!primary.first_name?.trim()) {
      if (errEl) { errEl.textContent = 'Nama awal penulis utama wajib diisi.'; errEl.classList.remove('hidden'); }
      return;
    }
    if (!primary.phone?.trim()) {
      if (errEl) { errEl.textContent = 'Nomor HP penulis utama wajib diisi.'; errEl.classList.remove('hidden'); }
      return;
    }

    const coAuthors = helpers.getCoAuthors();
    const fileInput = form.elements.namedItem('file');
    const file = fileInput?.files?.[0];

    if (!file) {
      if (errEl) { errEl.textContent = 'File Word wajib diunggah.'; errEl.classList.remove('hidden'); }
      return;
    }

    const ext = file.name.toLowerCase().slice(file.name.lastIndexOf('.'));
    if (!ALLOWED.includes(ext)) {
      if (errEl) { errEl.textContent = 'Hanya file Word (.doc / .docx).'; errEl.classList.remove('hidden'); }
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Mengirim...';
    errEl?.classList.add('hidden');

    try {
      const fd = new FormData(form);
      fd.set(
        'authors_json',
        JSON.stringify({
          primary,
          coAuthors: coAuthors.map(({ photoFile, photoPreview, ...rest }) => rest),
        }),
      );

      coAuthors.forEach((c, i) => {
        if (c.photoFile) fd.set(`coauthor_photo_${i}`, c.photoFile);
      });

      const primaryPhoto = helpers.getPrimaryPhotoFile();
      if (primaryPhoto) fd.set('primary_photo', primaryPhoto);

      const res = await fetch('/api/manuscripts/submit', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin',
      });

      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        window.location.href = `${kirimPath}?success=1`;
        return;
      }
      if (errEl) {
        errEl.textContent = data.error ?? 'Gagal mengirim naskah.';
        errEl.classList.remove('hidden');
      }
    } catch {
      if (errEl) {
        errEl.textContent = 'Gagal mengirim. Periksa koneksi.';
        errEl.classList.remove('hidden');
      }
    } finally {
      btn.disabled = false;
      btn.textContent = 'Kirim Naskah';
    }
  });
</script>
