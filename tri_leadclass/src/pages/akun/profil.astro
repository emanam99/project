---
import AuthorLayout from '../../layouts/AuthorLayout.astro';
import {
  formatContributorName,
  getUserAuthorProfile,
  splitDisplayName,
} from '../../lib/contributors.ts';
import { mediaUrl } from '../../lib/uploads.ts';
import { portalRoute } from '../../lib/portal-urls.ts';

const user = Astro.locals.user;
const onPenulis = Astro.locals.isPenulisHost;
if (!user) {
  return Astro.redirect(`${portalRoute('kirimNaskah', onPenulis)}?error=${encodeURIComponent('Silakan login untuk mengakses profil.')}`);
}

const profile = getUserAuthorProfile(user.id);
const split = splitDisplayName(user.name);
const saved = Astro.url.searchParams.get('saved') === '1';
const photoUrl = profile?.photo_path ? mediaUrl(profile.photo_path) : user.picture;
const profilPath = portalRoute('profil', onPenulis);

const displayName =
  formatContributorName({
    title_prefix: profile?.title_prefix,
    first_name: profile?.first_name ?? split.first,
    middle_name: profile?.middle_name,
    last_name: profile?.last_name ?? split.last,
    title_suffix: profile?.title_suffix,
  }) || user.name || 'Penulis';
---

<AuthorLayout title="Profil — TRI_LEADCLASS">
  <div class="author-profile-page">
    {saved && (
      <div class="author-toast" role="status">Profil berhasil disimpan.</div>
    )}

    <form id="profile-form" enctype="multipart/form-data">
      <header class="author-profile-hero">
        <div class="author-profile-avatar-wrap">
          <img id="profile-photo" src={photoUrl ?? '/icon/icon96.png'} alt="" class="author-profile-avatar" width="88" height="88" />
          <label class="author-profile-change" aria-label="Ganti foto profil">
            ✎
            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" data-photo-crop="circle" class="hidden" id="photo-input" />
          </label>
        </div>
        <div class="author-profile-hero-text">
          <p class="author-profile-name">{displayName}</p>
          <p class="author-profile-email">{user.email}</p>
        </div>
      </header>

      <div class="author-form-stack">
        <section class="author-form-section author-form-section--wide" aria-labelledby="sec-nama">
          <h2 id="sec-nama" class="author-form-section-title">Nama & identitas</h2>
          <div class="author-field-row">
            <div class="author-field">
              <label for="title_prefix">Gelar awal</label>
              <input type="text" id="title_prefix" name="title_prefix" value={profile?.title_prefix ?? ''} placeholder="Dr., Prof." autocomplete="honorific-prefix" />
            </div>
            <div class="author-field">
              <label for="title_suffix">Gelar akhir</label>
              <input type="text" id="title_suffix" name="title_suffix" value={profile?.title_suffix ?? ''} placeholder="M.Pd., Ph.D." autocomplete="honorific-suffix" />
            </div>
          </div>
          <div class="author-field">
            <label for="first_name">Nama awal *</label>
            <input type="text" id="first_name" name="first_name" required value={profile?.first_name ?? split.first} autocomplete="given-name" />
          </div>
          <div class="author-field-row">
            <div class="author-field">
              <label for="middle_name">Nama tengah</label>
              <input type="text" id="middle_name" name="middle_name" value={profile?.middle_name ?? ''} autocomplete="additional-name" />
            </div>
            <div class="author-field">
              <label for="last_name">Nama akhir</label>
              <input type="text" id="last_name" name="last_name" value={profile?.last_name ?? split.last} autocomplete="family-name" />
            </div>
          </div>
          <div class="author-field">
            <label for="id_number">NIM / NIDN / NIK</label>
            <input type="text" id="id_number" name="id_number" value={profile?.id_number ?? ''} inputmode="numeric" />
          </div>
        </section>

        <section class="author-form-section" aria-labelledby="sec-kontak">
          <h2 id="sec-kontak" class="author-form-section-title">Kontak</h2>
          <div class="author-field">
            <label for="email-display">Email</label>
            <input type="email" id="email-display" value={user.email} readonly tabindex="-1" />
          </div>
          <div class="author-field">
            <label for="phone">Nomor HP *</label>
            <input type="tel" id="phone" name="phone" required value={profile?.phone ?? ''} autocomplete="tel" inputmode="tel" placeholder="08xxxxxxxxxx" />
          </div>
        </section>

        <section class="author-form-section" aria-labelledby="sec-afiliasi">
          <h2 id="sec-afiliasi" class="author-form-section-title">Afiliasi</h2>
          <div class="author-field">
            <label for="institution">Instansi</label>
            <input type="text" id="institution" name="institution" value={profile?.institution ?? ''} autocomplete="organization" placeholder="Universitas / lembaga" />
          </div>
          <div class="author-field">
            <label for="position_status">Jabatan / status</label>
            <input type="text" id="position_status" name="position_status" value={profile?.position_status ?? ''} placeholder="Mahasiswa, Dosen, ..." />
          </div>
        </section>
      </div>

      <p id="profile-error" class="text-xs text-red-600 hidden px-4 mt-2 md:px-0" role="alert"></p>

      <div class="author-sticky-save md:mt-2">
        <button type="submit" id="profile-save" class="author-btn-primary">Simpan profil</button>
      </div>
    </form>
  </div>
</AuthorLayout>

<script define:vars={{ profilPath }}>
  const form = document.getElementById('profile-form');
  const btn = document.getElementById('profile-save');
  const errEl = document.getElementById('profile-error');
  const photoInput = document.getElementById('photo-input');
  const photoImg = document.getElementById('profile-photo');

  photoInput?.addEventListener('change', updateProfilePhoto);
  photoInput?.addEventListener('tri-photo-cropped', updateProfilePhoto);

  function updateProfilePhoto() {
    const file = photoInput?.files?.[0];
    if (file && photoImg) photoImg.src = URL.createObjectURL(file);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Menyimpan...';
    errEl?.classList.add('hidden');

    try {
      const res = await fetch('/api/auth/profile', {
        method: 'PATCH',
        body: new FormData(form),
        credentials: 'same-origin',
      });
      const data = await res.json();
      if (res.ok) {
        window.location.href = `${profilPath}?saved=1`;
        return;
      }
      if (errEl) {
        errEl.textContent = data.error ?? 'Gagal menyimpan profil.';
        errEl.classList.remove('hidden');
      }
    } catch {
      if (errEl) {
        errEl.textContent = 'Gagal menghubungi server.';
        errEl.classList.remove('hidden');
      }
    } finally {
      btn.disabled = false;
      btn.textContent = 'Simpan profil';
    }
  });
</script>
