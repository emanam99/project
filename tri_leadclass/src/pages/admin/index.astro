---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import { countManuscriptsByStatus } from '../../lib/manuscripts.ts';

const counts = countManuscriptsByStatus();
const total = Object.values(counts).reduce((a, b) => a + b, 0);
const pending = counts.pending ?? 0;

const statusLabels: Record<string, string> = {
  pending: 'Menunggu',
  reviewing: 'Ditinjau',
  revision: 'Revisi',
  accepted: 'Diterima',
  rejected: 'Ditolak',
  published: 'Diterbitkan',
};

const statusIcons: Record<string, string> = {
  pending: '⏳',
  reviewing: '🔍',
  revision: '✏️',
  accepted: '✅',
  rejected: '❌',
  published: '📰',
};
---

<AdminLayout title="Dashboard Admin — TRI_LEADCLASS">
  <div class="admin-page max-w-6xl mx-auto">
    <AdminPageHeader title="Dashboard" subtitle="Ringkasan pengajuan naskah jurnal." />

    {/* Highlight card */}
    <div class="admin-card rounded-2xl p-5 md:p-6 mb-6 bg-gradient-to-br from-emerald-600 to-emerald-800 text-white border-0 shadow-lg shadow-emerald-900/20">
      <p class="text-emerald-100 text-sm font-medium">Total pengajuan</p>
      <p class="text-4xl md:text-5xl font-black mt-1">{total}</p>
      {pending > 0 && (
        <p class="mt-3 text-sm text-emerald-100/90">
          <span class="inline-flex items-center gap-1.5 bg-white/15 rounded-full px-3 py-1 font-semibold">
            {pending} menunggu tinjauan
          </span>
        </p>
      )}
      <a href="/admin/naskah" class="inline-flex mt-4 text-sm font-semibold text-white/90 hover:text-white underline underline-offset-4">
        Kelola semua naskah →
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
      {
        Object.entries(counts).map(([status, n]) => (
          <a
            href={`/admin/naskah?status=${status}`}
            class="admin-card admin-stat-card rounded-2xl p-4 md:p-5 block"
          >
            <span class="text-lg" aria-hidden="true">{statusIcons[status]}</span>
            <p class="text-2xl md:text-3xl font-bold text-slate-900 mt-2">{n}</p>
            <p class="text-[11px] md:text-xs text-slate-500 font-semibold uppercase tracking-wide mt-1 leading-tight">
              {statusLabels[status] ?? status}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</AdminLayout>
