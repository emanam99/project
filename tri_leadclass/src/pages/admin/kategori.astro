---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import { listCategoriesWithStats } from '../../lib/categories.ts';

const categories = listCategoriesWithStats();
---

<AdminLayout title="Kelola Kategori — Admin">
  <div class="admin-page max-w-4xl mx-auto">
    <AdminPageHeader
      title="Kelola Kategori"
      subtitle={`${categories.length} kategori · tampil di navigasi web utama`}
    />

    <div class="admin-card rounded-2xl p-4 md:p-5 mb-6">
      <p class="text-sm font-semibold text-slate-900 mb-1">Tambah Kategori</p>
      <p class="text-xs text-slate-500 mb-4">
        Kategori baru langsung muncul di menu beranda dan form kirim naskah.
      </p>
      <form id="add-form" class="flex flex-col sm:flex-row gap-2">
        <input
          type="text"
          name="name"
          required
          minlength="2"
          placeholder="Nama kategori, contoh: Kepemimpinan"
          class="flex-1 text-sm border border-slate-200 rounded-xl px-4 py-2.5 bg-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
        />
        <button
          type="submit"
          id="add-btn"
          class="shrink-0 bg-emerald-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-emerald-700 transition-colors disabled:opacity-60"
        >
          Tambah
        </button>
      </form>
      <p class="text-xs text-red-600 hidden mt-2" id="add-error"></p>
    </div>

    {
      categories.length === 0 ? (
        <div class="admin-card rounded-2xl p-10 text-center">
          <p class="text-slate-600 font-medium">Belum ada kategori</p>
          <p class="text-sm text-slate-400 mt-1">Tambahkan kategori pertama di atas.</p>
        </div>
      ) : (
        <>
          <div class="md:hidden space-y-3">
            {
              categories.map((c) => (
                <div class="admin-card rounded-2xl p-4" data-category={c.id}>
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <div class="min-w-0">
                      <p class="font-semibold text-slate-900">{c.name}</p>
                      <p class="text-xs text-slate-400 font-mono truncate">/{c.slug}</p>
                    </div>
                    <span class="text-xs text-slate-500 shrink-0">{c.article_count} artikel</span>
                  </div>
                  <form class="flex gap-2" data-edit-form>
                    <input
                      type="text"
                      name="name"
                      value={c.name}
                      required
                      minlength="2"
                      class="flex-1 text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white"
                    />
                    <button type="submit" class="shrink-0 bg-slate-900 text-white text-sm font-semibold px-4 py-2.5 rounded-xl">
                      Simpan
                    </button>
                  </form>
                </div>
              ))
            }
          </div>

          <div class="hidden md:block admin-card rounded-2xl overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-slate-50/80 text-left text-xs uppercase tracking-wider text-slate-500">
                <tr>
                  <th class="px-5 py-3.5 font-semibold">Nama</th>
                  <th class="px-5 py-3.5 font-semibold">Slug</th>
                  <th class="px-5 py-3.5 font-semibold">Artikel</th>
                  <th class="px-5 py-3.5 font-semibold">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {
                  categories.map((c) => (
                    <tr data-category={c.id} class="hover:bg-slate-50/50">
                      <td class="px-5 py-4 font-medium text-slate-900">{c.name}</td>
                      <td class="px-5 py-4 text-slate-500 font-mono text-xs">{c.slug}</td>
                      <td class="px-5 py-4 text-slate-600">{c.article_count}</td>
                      <td class="px-5 py-4">
                        <form class="flex gap-2 items-center" data-edit-form>
                          <input
                            type="text"
                            name="name"
                            value={c.name}
                            required
                            minlength="2"
                            class="text-sm border border-slate-200 rounded-xl px-3 py-2 bg-white w-48"
                          />
                          <button type="submit" class="text-sm bg-slate-900 text-white font-semibold px-4 py-2 rounded-xl hover:bg-slate-800">
                            Simpan
                          </button>
                        </form>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </>
      )
    }
  </div>
</AdminLayout>

<script>
  const addForm = document.getElementById('add-form') as HTMLFormElement | null;
  const addBtn = document.getElementById('add-btn') as HTMLButtonElement | null;
  const addError = document.getElementById('add-error');

  addForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!addBtn) return;

    const name = (addForm.elements.namedItem('name') as HTMLInputElement).value.trim();
    addBtn.disabled = true;
    addError?.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      const data = await res.json();
      if (res.ok) location.reload();
      else if (addError) {
        addError.textContent = data.error ?? 'Gagal menambah kategori.';
        addError.classList.remove('hidden');
      }
    } finally {
      addBtn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLFormElement>('[data-edit-form]').forEach((form) => {
    const row = form.closest('[data-category]');
    const id = Number(row?.getAttribute('data-category'));
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn) btn.disabled = true;
      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();

      const res = await fetch('/api/admin/categories', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, name }),
      });

      if (res.ok) location.reload();
      else {
        const data = await res.json();
        alert(data.error ?? 'Gagal memperbarui kategori.');
        if (btn) btn.disabled = false;
      }
    });
  });
</script>
