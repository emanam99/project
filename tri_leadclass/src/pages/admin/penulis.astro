---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import {
  formatPersonName,
  getPersonPhoto,
  listAllPersonProfiles,
} from '../../lib/person-profiles.ts';
import { mediaUrl } from '../../lib/uploads.ts';

const profiles = listAllPersonProfiles();

function photoUrl(p: { photo_path: string | null; google_picture: string | null }): string {
  const src = getPersonPhoto(p as Parameters<typeof getPersonPhoto>[0]);
  if (src?.startsWith('uploads/')) return mediaUrl(src) ?? '/icon/icon96.png';
  if (src?.startsWith('http')) return src;
  return '/icon/icon96.png';
}

function roleLabel(p: (typeof profiles)[0]): string {
  const parts: string[] = [];
  if (p.is_contributor) parts.push('Penulis');
  if (p.is_board_member) parts.push(p.editorial_role?.trim() || 'Redaksi');
  return parts.join(' · ') || 'Profil';
}

const profilesJson = profiles.map((p) => ({
  email: p.email,
  user_id: p.user_id,
  title_prefix: p.title_prefix,
  first_name: p.first_name,
  middle_name: p.middle_name,
  last_name: p.last_name,
  title_suffix: p.title_suffix,
  id_number: p.id_number,
  phone: p.phone,
  institution: p.institution,
  position_status: p.position_status,
  photo_url: photoUrl(p),
  display_name: formatPersonName(p),
  roles: roleLabel(p),
  is_contributor: p.is_contributor,
  is_board_member: p.is_board_member,
  contributor_slug: p.contributor_slug,
  search: [p.first_name, p.middle_name, p.last_name, p.email, p.institution, p.editorial_role]
    .filter(Boolean)
    .join(' ')
    .toLowerCase(),
}));
---

<AdminLayout title="Biodata Penulis — Admin">
  <div class="admin-page max-w-4xl mx-auto">
    <AdminPageHeader
      title="Biodata Penulis & Redaksi"
      subtitle={`${profiles.length} profil · satu biodata per email`}
    />

    <div class="mb-6">
      <input
        type="search"
        id="author-search"
        placeholder="Cari nama, email, instansi..."
        class="w-full text-sm border border-slate-200 rounded-xl pl-4 pr-4 py-2.5 bg-white focus:outline-none focus:border-emerald-500"
      />
    </div>

    {
      profiles.length === 0 ? (
        <div class="admin-card rounded-2xl p-10 text-center">
          <p class="text-slate-600">Belum ada biodata di database.</p>
          <p class="text-sm text-slate-400 mt-1">Profil muncul setelah penulis mengirim naskah atau ditambahkan ke redaksi.</p>
        </div>
      ) : (
        <div class="space-y-3" id="author-list">
          {
            profiles.map((p) => (
              <div
                class="author-item admin-card rounded-2xl p-4 flex items-center gap-4"
                data-search={[p.first_name, p.middle_name, p.last_name, p.email, p.institution, p.editorial_role].filter(Boolean).join(' ').toLowerCase()}
              >
                <img src={photoUrl(p)} alt="" class="h-11 w-11 rounded-full object-cover shrink-0" />
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-slate-900 truncate">{formatPersonName(p)}</p>
                  <p class="text-xs text-slate-500 truncate">{p.email}</p>
                  <p class="text-[11px] text-emerald-700 truncate mt-0.5">{roleLabel(p)}</p>
                  {p.institution && (
                    <p class="text-[11px] text-slate-400 truncate mt-0.5">{p.institution}</p>
                  )}
                </div>
                <div class="flex shrink-0 gap-2">
                  {p.contributor_slug && (
                    <a
                      href={`/penulis/${p.contributor_slug}`}
                      target="_blank"
                      rel="noopener"
                      class="text-xs font-semibold text-slate-500 px-3 py-2 rounded-lg hover:bg-slate-100"
                    >
                      Lihat ↗
                    </a>
                  )}
                  <button
                    type="button"
                    class="author-edit-btn text-xs font-semibold text-emerald-700 px-3 py-2 rounded-lg hover:bg-emerald-50"
                    data-email={p.email}
                  >
                    Edit
                  </button>
                </div>
              </div>
            ))
          }
        </div>
      )
    }
  </div>

  <div id="author-backdrop" class="admin-offcanvas-backdrop motion-skip" aria-hidden="true"></div>
  <aside id="author-offcanvas" class="admin-offcanvas motion-skip" aria-hidden="true" aria-labelledby="author-oc-title">
    <div class="admin-offcanvas-head">
      <h2 id="author-oc-title" class="admin-offcanvas-title">Edit Biodata Penulis</h2>
      <button type="button" id="author-oc-close" class="admin-offcanvas-close" aria-label="Tutup">✕</button>
    </div>

    <form id="author-form" class="flex flex-col flex-1 min-h-0" enctype="multipart/form-data">
      <div class="admin-offcanvas-body space-y-3">
        <input type="hidden" name="original_email" id="author-original-email" value="" />

        <div class="flex flex-col items-center gap-2 pb-2">
          <img id="author-photo-preview" src="/icon/icon96.png" alt="" class="admin-board-photo rounded-full" />
          <label class="text-xs font-semibold text-emerald-700 cursor-pointer">
            Ganti foto
            <input type="file" name="photo" id="author-photo" accept="image/jpeg,image/png,image/webp" data-photo-crop="circle" class="hidden" />
          </label>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="admin-field-label" for="author-prefix">Gelar awal</label>
            <input type="text" id="author-prefix" name="title_prefix" class="admin-field" />
          </div>
          <div>
            <label class="admin-field-label" for="author-suffix">Gelar akhir</label>
            <input type="text" id="author-suffix" name="title_suffix" class="admin-field" />
          </div>
        </div>

        <div>
          <label class="admin-field-label" for="author-first">Nama awal *</label>
          <input type="text" id="author-first" name="first_name" required class="admin-field" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="admin-field-label" for="author-middle">Nama tengah</label>
            <input type="text" id="author-middle" name="middle_name" class="admin-field" />
          </div>
          <div>
            <label class="admin-field-label" for="author-last">Nama akhir</label>
            <input type="text" id="author-last" name="last_name" class="admin-field" />
          </div>
        </div>

        <div>
          <label class="admin-field-label" for="author-email">Email *</label>
          <input type="email" id="author-email" name="email" required class="admin-field" />
        </div>

        <div>
          <label class="admin-field-label" for="author-phone">Nomor HP *</label>
          <input type="tel" id="author-phone" name="phone" required class="admin-field" />
        </div>

        <div>
          <label class="admin-field-label" for="author-institution">Instansi</label>
          <input type="text" id="author-institution" name="institution" class="admin-field" />
        </div>

        <div>
          <label class="admin-field-label" for="author-position">Jabatan / status</label>
          <input type="text" id="author-position" name="position_status" class="admin-field" />
        </div>

        <div>
          <label class="admin-field-label" for="author-idnum">NIM / NIDN / NIK</label>
          <input type="text" id="author-idnum" name="id_number" class="admin-field" />
        </div>

        <p id="author-link-hint" class="text-xs text-slate-400 hidden"></p>
        <p id="author-form-error" class="text-xs text-red-600 hidden"></p>
      </div>

      <div class="admin-offcanvas-foot">
        <button type="submit" id="author-save-btn" class="w-full bg-emerald-600 text-white text-sm font-semibold py-3 rounded-xl hover:bg-emerald-700">
          Simpan biodata
        </button>
      </div>
    </form>
  </aside>

  <script define:vars={{ profilesJson }}>
    const authorsByEmail = Object.fromEntries(profilesJson.map((p) => [p.email, p]));

    function portalOffcanvas() {
      document.querySelectorAll('.admin-offcanvas, .admin-offcanvas-backdrop').forEach((el) => {
        if (el.parentElement !== document.body) document.body.appendChild(el);
      });
    }

    function closeAuthorOffcanvas() {
      const backdrop = document.getElementById('author-backdrop');
      const panel = document.getElementById('author-offcanvas');
      backdrop?.classList.remove('is-open');
      panel?.classList.remove('is-open');
      backdrop?.setAttribute('aria-hidden', 'true');
      panel?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('admin-offcanvas-open');
      panel?.style.removeProperty('transform');
    }

    function openAuthorOffcanvas() {
      const backdrop = document.getElementById('author-backdrop');
      const panel = document.getElementById('author-offcanvas');
      backdrop?.classList.add('is-open');
      panel?.classList.add('is-open');
      backdrop?.setAttribute('aria-hidden', 'false');
      panel?.setAttribute('aria-hidden', 'false');
      document.body.classList.add('admin-offcanvas-open');
      if (panel) panel.style.transform = 'translate3d(0, 0, 0)';
    }

    function fillAuthorForm(c) {
      const photoPreview = document.getElementById('author-photo-preview');
      const photoInput = document.getElementById('author-photo');
      const linkHint = document.getElementById('author-link-hint');
      const errEl = document.getElementById('author-form-error');

      document.getElementById('author-original-email').value = c?.email ?? '';
      document.getElementById('author-prefix').value = c?.title_prefix ?? '';
      document.getElementById('author-suffix').value = c?.title_suffix ?? '';
      document.getElementById('author-first').value = c?.first_name ?? '';
      document.getElementById('author-middle').value = c?.middle_name ?? '';
      document.getElementById('author-last').value = c?.last_name ?? '';
      document.getElementById('author-email').value = c?.email ?? '';
      document.getElementById('author-phone').value = c?.phone ?? '';
      document.getElementById('author-institution').value = c?.institution ?? '';
      document.getElementById('author-position').value = c?.position_status ?? '';
      document.getElementById('author-idnum').value = c?.id_number ?? '';

      if (photoPreview) photoPreview.src = c?.photo_url ?? '/icon/icon96.png';
      if (photoInput) photoInput.value = '';
      if (errEl) errEl.classList.add('hidden');

      if (linkHint) {
        const roles = c?.roles || '';
        if (c?.user_id || roles) {
          linkHint.textContent =
            (roles ? roles + ' · ' : '') +
            (c?.user_id ? 'Akun #' + c.user_id + ' · ' : '') +
            'Perubahan biodata berlaku untuk semua entri dengan email ini.';
          linkHint.classList.remove('hidden');
        } else {
          linkHint.textContent = 'Perubahan biodata berlaku untuk semua entri dengan email ini.';
          linkHint.classList.remove('hidden');
        }
      }

      const titleEl = document.getElementById('author-oc-title');
      if (titleEl) titleEl.textContent = 'Edit · ' + (c?.display_name || 'Penulis');
    }

    function openAuthorEdit(email) {
      const c = authorsByEmail[email];
      if (!c) return;
      fillAuthorForm(c);
      openAuthorOffcanvas();
    }

    function initAuthorPage() {
      portalOffcanvas();
      document.querySelectorAll('.admin-offcanvas, .admin-offcanvas-backdrop').forEach((el) => {
        el.removeAttribute('data-aos');
        el.removeAttribute('data-aos-delay');
        el.removeAttribute('data-aos-duration');
        el.style.removeProperty('transform');
        el.style.removeProperty('opacity');
      });
      closeAuthorOffcanvas();

      const form = document.getElementById('author-form');
      if (!form || !form.dataset.authorPage) return;

      const searchInput = document.getElementById('author-search');
      const closeBtn = document.getElementById('author-oc-close');
      const backdrop = document.getElementById('author-backdrop');
      const photoInput = document.getElementById('author-photo');
      const photoPreview = document.getElementById('author-photo-preview');

      if (searchInput && !searchInput.dataset.bound) {
        searchInput.dataset.bound = '1';
        searchInput.addEventListener('input', (e) => {
          const q = e.target.value.trim().toLowerCase();
          document.querySelectorAll('.author-item').forEach((el) => {
            const hay = el.dataset.search ?? '';
            el.style.display = !q || hay.includes(q) ? '' : 'none';
          });
        });
      }

      document.querySelectorAll('.author-edit-btn').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => openAuthorEdit(btn.dataset.email));
      });

      if (closeBtn && !closeBtn.dataset.bound) {
        closeBtn.dataset.bound = '1';
        closeBtn.addEventListener('click', closeAuthorOffcanvas);
      }

      if (backdrop && !backdrop.dataset.bound) {
        backdrop.dataset.bound = '1';
        backdrop.addEventListener('click', closeAuthorOffcanvas);
      }

      if (photoInput && !photoInput.dataset.bound) {
        photoInput.dataset.bound = '1';
        const updatePreview = () => {
          const f = photoInput.files?.[0];
          if (f && photoPreview) photoPreview.src = URL.createObjectURL(f);
        };
        photoInput.addEventListener('change', updatePreview);
        photoInput.addEventListener('tri-photo-cropped', updatePreview);
      }

      if (form && !form.dataset.submitBound) {
        form.dataset.submitBound = '1';
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const errEl = document.getElementById('author-form-error');
          const saveBtn = document.getElementById('author-save-btn');
          errEl?.classList.add('hidden');
          if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.textContent = 'Menyimpan…';
          }

          try {
            const res = await fetch('/api/admin/contributors', { method: 'PATCH', body: new FormData(form) });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Gagal menyimpan');
            location.reload();
          } catch (err) {
            if (errEl) {
              errEl.textContent = err instanceof Error ? err.message : 'Gagal';
              errEl.classList.remove('hidden');
            }
            if (saveBtn) {
              saveBtn.disabled = false;
              saveBtn.textContent = 'Simpan biodata';
            }
          }
        });
      }
    }

    const authorForm = document.getElementById('author-form');
    if (authorForm) authorForm.dataset.authorPage = '1';

    initAuthorPage();
    document.addEventListener('astro:page-load', initAuthorPage);
    document.addEventListener('astro:after-swap', initAuthorPage);

    if (!document.documentElement.dataset.authorEsc) {
      document.documentElement.dataset.authorEsc = '1';
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAuthorOffcanvas();
      });
    }
  </script>
</AdminLayout>
