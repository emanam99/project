---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import { listSitePages } from '../../lib/site-pages.ts';

const pages = listSitePages();
const journalPages = pages.filter((p) => p.section === 'journal');
const policyPages = pages.filter((p) => p.section === 'policy');
---

<AdminLayout title="Kelola Halaman — Admin">
  <div class="admin-page max-w-4xl mx-auto">
    <AdminPageHeader
      title="Halaman Jurnal & Kebijakan"
      subtitle="Konten footer — Edisi Jurnal dan Kebijakan"
    />

    <p class="text-xs text-slate-500 mb-6">
      Dewan Redaksi dikelola terpisah di menu <a href="/admin/redaksi" class="text-emerald-700 font-semibold hover:underline">Redaksi</a>.
    </p>

    <section class="mb-8">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Edisi Jurnal</h2>
      <div class="space-y-3">
        {
          journalPages.map((p) => (
            <details class="admin-card rounded-2xl overflow-hidden group" data-page-id={p.id}>
              <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer list-none">
                <div class="min-w-0">
                  <p class="font-semibold text-slate-900">{p.title}</p>
                  <p class="text-xs text-slate-400 font-mono">/halaman/{p.slug}</p>
                </div>
                <span class="text-xs text-emerald-600 shrink-0">Edit</span>
              </summary>
              <form class="border-t border-slate-100 p-4 space-y-3 page-edit-form">
                <input type="hidden" name="id" value={p.id} />
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Judul</label>
                  <input type="text" name="title" required value={p.title} class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Ringkasan</label>
                  <input type="text" name="excerpt" value={p.excerpt ?? ''} class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Isi halaman</label>
                  <textarea name="content" rows="8" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white font-mono leading-relaxed">{p.content}</textarea>
                  <p class="text-[10px] text-slate-400 mt-1">Pisahkan paragraf dengan baris kosong.</p>
                </div>
                <p class="text-xs text-red-600 hidden page-error"></p>
                <button type="submit" class="bg-emerald-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-emerald-700">Simpan</button>
              </form>
            </details>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Kebijakan</h2>
      <div class="space-y-3">
        {
          policyPages.map((p) => (
            <details class="admin-card rounded-2xl overflow-hidden group" data-page-id={p.id}>
              <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer list-none">
                <div class="min-w-0">
                  <p class="font-semibold text-slate-900">{p.title}</p>
                  <p class="text-xs text-slate-400 font-mono">/halaman/{p.slug}</p>
                </div>
                <span class="text-xs text-emerald-600 shrink-0">Edit</span>
              </summary>
              <form class="border-t border-slate-100 p-4 space-y-3 page-edit-form">
                <input type="hidden" name="id" value={p.id} />
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Judul</label>
                  <input type="text" name="title" required value={p.title} class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Ringkasan</label>
                  <input type="text" name="excerpt" value={p.excerpt ?? ''} class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Isi halaman</label>
                  <textarea name="content" rows="8" class="w-full text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white font-mono leading-relaxed">{p.content}</textarea>
                </div>
                <p class="text-xs text-red-600 hidden page-error"></p>
                <button type="submit" class="bg-emerald-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-emerald-700">Simpan</button>
              </form>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <script>
    document.querySelectorAll('.page-edit-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.currentTarget as HTMLFormElement;
        const errEl = f.querySelector('.page-error') as HTMLElement;
        const btn = f.querySelector('button[type=submit]') as HTMLButtonElement;
        errEl.classList.add('hidden');
        btn.disabled = true;

        const fd = new FormData(f);
        const body = {
          id: Number(fd.get('id')),
          title: String(fd.get('title') ?? ''),
          excerpt: String(fd.get('excerpt') ?? ''),
          content: String(fd.get('content') ?? ''),
        };

        try {
          const res = await fetch('/api/admin/site-pages', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Gagal menyimpan');
          btn.textContent = 'Tersimpan ✓';
          setTimeout(() => { btn.textContent = 'Simpan'; btn.disabled = false; }, 1500);
        } catch (err) {
          errEl.textContent = err instanceof Error ? err.message : 'Gagal menyimpan';
          errEl.classList.remove('hidden');
          btn.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>
