---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import { listUsers } from '../../lib/users.ts';

const users = listUsers();

const roleLabels: Record<string, string> = {
  super_admin: 'Super Admin',
  admin: 'Admin',
  user: 'Penulis',
};

const roleBadge: Record<string, string> = {
  super_admin: 'bg-violet-100 text-violet-800',
  admin: 'bg-emerald-100 text-emerald-800',
  user: 'bg-slate-100 text-slate-700',
};

const pendingCount = users.filter((u) => !u.google_id).length;
const adminCount = users.filter((u) => u.role === 'admin' || u.role === 'super_admin').length;
const writerCount = users.filter((u) => u.role === 'user').length;

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch {
    return '—';
  }
}
---

<AdminLayout title="Kelola Pengguna — Admin">
  <div class="admin-page admin-users-page mx-auto">
    <AdminPageHeader
      title="Kelola Pengguna"
      subtitle={`${users.length} pengguna · ${pendingCount} belum pernah login`}
    />

    <div class="hidden md:grid grid-cols-4 gap-3 mb-6">
      <div class="admin-card rounded-2xl p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total</p>
        <p class="text-2xl font-bold text-slate-900 mt-1">{users.length}</p>
      </div>
      <div class="admin-card rounded-2xl p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Admin</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">{adminCount}</p>
      </div>
      <div class="admin-card rounded-2xl p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Penulis</p>
        <p class="text-2xl font-bold text-slate-700 mt-1">{writerCount}</p>
      </div>
      <div class="admin-card rounded-2xl p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Belum login</p>
        <p class="text-2xl font-bold text-amber-600 mt-1">{pendingCount}</p>
      </div>
    </div>

    {/* Berikan akses — pre-register email */}
    <div class="admin-card rounded-2xl p-4 md:p-5 mb-6">
      <div class="md:flex md:items-start md:justify-between md:gap-6 mb-4">
        <div class="md:max-w-md">
          <p class="text-sm font-semibold text-slate-900 mb-1">Berikan Akses</p>
          <p class="text-xs text-slate-500">
            Tambahkan email yang belum pernah login. Saat pengguna masuk dengan Google, role langsung aktif.
          </p>
        </div>
      </div>
      <form id="grant-form" class="flex flex-col md:flex-row gap-2 md:items-center">
        <input
          type="email"
          name="email"
          required
          placeholder="email@contoh.com"
          class="flex-1 text-sm border border-slate-200 rounded-xl px-4 py-2.5 bg-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
        />
        <select
          name="role"
          class="text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white md:w-40"
        >
          <option value="admin">Admin</option>
          <option value="user">Penulis</option>
        </select>
        <button
          type="submit"
          id="grant-btn"
          class="shrink-0 bg-emerald-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-emerald-700 transition-colors disabled:opacity-60"
        >
          Berikan Akses
        </button>
      </form>
      <p class="text-xs text-red-600 hidden mt-2" id="grant-error"></p>
      <p class="text-xs text-emerald-700 hidden mt-2" id="grant-success"></p>
    </div>

    {/* Cari & filter */}
    <div class="flex flex-col md:flex-row md:items-center gap-3 mb-4 md:mb-6">
      <div class="relative flex-1 md:max-w-md">
        <input
          type="search"
          id="user-search"
          placeholder="Cari nama atau email..."
          class="w-full text-sm border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 bg-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
        />
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
        </svg>
      </div>
      <select
        id="role-filter"
        class="text-sm border border-slate-200 rounded-xl px-4 py-2.5 bg-white md:w-48 shrink-0"
      >
        <option value="">Semua role</option>
        <option value="super_admin">Super Admin</option>
        <option value="admin">Admin</option>
        <option value="user">Penulis</option>
        <option value="pending">Belum login</option>
      </select>
    </div>

    <p class="text-xs text-slate-400 mb-4 hidden" id="filter-empty">
      Tidak ada pengguna yang cocok dengan pencarian.
    </p>

    {/* Mobile: kartu */}
    <div class="md:hidden space-y-3" id="user-list-mobile">
      {
        users.map((u) => (
          <div
            class="admin-card rounded-2xl p-4 user-row"
            data-user={u.id}
            data-role={u.role}
            data-pending={u.google_id ? '0' : '1'}
            data-search={`${(u.name ?? '').toLowerCase()} ${u.email.toLowerCase()}`}
          >
            <div class="flex items-center gap-3 mb-3">
              {u.picture ? (
                <img src={u.picture} alt="" class="h-11 w-11 rounded-full ring-2 ring-slate-100" />
              ) : (
                <div class="h-11 w-11 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 font-bold">
                  {(u.name ?? u.email).charAt(0).toUpperCase()}
                </div>
              )}
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-slate-900 truncate">{u.name ?? '—'}</p>
                <p class="text-xs text-slate-500 truncate">{u.email}</p>
                {!u.google_id && (
                  <span class="inline-block mt-1 text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">
                    Belum login
                  </span>
                )}
              </div>
              <span class:list={['shrink-0 text-[10px] font-bold uppercase px-2 py-1 rounded-full', roleBadge[u.role]]}>
                {roleLabels[u.role]}
              </span>
            </div>
            <form class="flex gap-2" data-role-form>
              <select name="role" class="flex-1 text-sm border border-slate-200 rounded-xl px-3 py-2.5 bg-white">
                <option value="user" selected={u.role === 'user'}>Penulis</option>
                <option value="admin" selected={u.role === 'admin'}>Admin</option>
                <option value="super_admin" selected={u.role === 'super_admin'}>Super Admin</option>
              </select>
              <button type="submit" class="shrink-0 bg-slate-900 text-white text-sm font-semibold px-4 py-2.5 rounded-xl hover:bg-slate-800">
                Simpan
              </button>
            </form>
          </div>
        ))
      }
    </div>

    {/* Desktop: tabel */}
    <div class="hidden md:block admin-card rounded-2xl overflow-hidden" id="user-list-desktop">
      <div class="overflow-x-auto">
        <table class="admin-users-table w-full text-sm">
          <thead>
            <tr>
              <th>Pengguna</th>
              <th class="w-32">Status</th>
              <th class="w-64">Role</th>
              <th class="w-28">Terdaftar</th>
            </tr>
          </thead>
          <tbody>
            {
              users.map((u) => (
                <tr
                  data-user={u.id}
                  data-role={u.role}
                  data-pending={u.google_id ? '0' : '1'}
                  data-search={`${(u.name ?? '').toLowerCase()} ${u.email.toLowerCase()}`}
                  class="user-row"
                >
                  <td>
                    <div class="flex items-center gap-3 min-w-0">
                      {u.picture ? (
                        <img src={u.picture} alt="" class="h-10 w-10 rounded-full ring-2 ring-slate-100 shrink-0" />
                      ) : (
                        <div class="h-10 w-10 rounded-full bg-slate-200 flex items-center justify-center text-slate-500 text-sm font-bold shrink-0">
                          {(u.name ?? u.email).charAt(0).toUpperCase()}
                        </div>
                      )}
                      <div class="min-w-0">
                        <p class="font-semibold text-slate-900 truncate">{u.name ?? '—'}</p>
                        <p class="text-xs text-slate-500 truncate">{u.email}</p>
                      </div>
                    </div>
                  </td>
                  <td>
                    {!u.google_id ? (
                      <span class="admin-users-badge admin-users-badge--pending">Belum login</span>
                    ) : (
                      <span class="admin-users-badge admin-users-badge--active">Aktif</span>
                    )}
                  </td>
                  <td>
                    <form class="admin-users-role-form" data-role-form>
                      <select name="role" class="admin-users-select">
                        <option value="user" selected={u.role === 'user'}>Penulis</option>
                        <option value="admin" selected={u.role === 'admin'}>Admin</option>
                        <option value="super_admin" selected={u.role === 'super_admin'}>Super Admin</option>
                      </select>
                      <button type="submit" class="admin-users-save">Simpan</button>
                    </form>
                  </td>
                  <td class="text-slate-500 text-xs whitespace-nowrap">{formatDate(u.created_at)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const searchInput = document.getElementById('user-search') as HTMLInputElement | null;
  const roleFilter = document.getElementById('role-filter') as HTMLSelectElement | null;
  const filterEmpty = document.getElementById('filter-empty');
  const rows = document.querySelectorAll<HTMLElement>('.user-row');

  function applyFilters() {
    const q = (searchInput?.value ?? '').trim().toLowerCase();
    const role = roleFilter?.value ?? '';
    let visible = 0;

    rows.forEach((row) => {
      const haystack = row.dataset.search ?? '';
      const rowRole = row.dataset.role ?? '';
      const pending = row.dataset.pending === '1';

      const matchSearch = !q || haystack.includes(q);
      const matchRole =
        !role ||
        (role === 'pending' ? pending : rowRole === role);

      const show = matchSearch && matchRole;
      row.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    filterEmpty?.classList.toggle('hidden', visible > 0);
  }

  searchInput?.addEventListener('input', applyFilters);
  roleFilter?.addEventListener('change', applyFilters);

  const grantForm = document.getElementById('grant-form') as HTMLFormElement | null;
  const grantBtn = document.getElementById('grant-btn') as HTMLButtonElement | null;
  const grantError = document.getElementById('grant-error');
  const grantSuccess = document.getElementById('grant-success');

  grantForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!grantBtn) return;

    const email = (grantForm.elements.namedItem('email') as HTMLInputElement).value.trim();
    const role = (grantForm.elements.namedItem('role') as HTMLSelectElement).value;

    grantBtn.disabled = true;
    grantError?.classList.add('hidden');
    grantSuccess?.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, role }),
      });
      const data = await res.json();

      if (res.ok) {
        if (grantSuccess) {
          grantSuccess.textContent = data.message ?? 'Akses berhasil diberikan.';
          grantSuccess.classList.remove('hidden');
        }
        setTimeout(() => location.reload(), 800);
        return;
      }

      if (grantError) {
        grantError.textContent = data.error ?? 'Gagal memberi akses.';
        grantError.classList.remove('hidden');
      }
    } catch {
      if (grantError) {
        grantError.textContent = 'Gagal menghubungi server.';
        grantError.classList.remove('hidden');
      }
    } finally {
      grantBtn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLFormElement>('[data-role-form]').forEach((form) => {
    const row = form.closest('[data-user]');
    const id = Number(row?.getAttribute('data-user'));
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn) btn.disabled = true;
      const role = (form.elements.namedItem('role') as HTMLSelectElement).value;
      const res = await fetch('/api/admin/users', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, role }),
      });
      if (res.ok) location.reload();
      else {
        const data = await res.json();
        alert(data.error ?? 'Gagal memperbarui role.');
        if (btn) btn.disabled = false;
      }
    });
  });
</script>
