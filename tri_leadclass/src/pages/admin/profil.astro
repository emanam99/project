---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import {
  formatContributorName,
  getUserAuthorProfile,
  splitDisplayName,
} from '../../lib/contributors.ts';
import { mediaUrl } from '../../lib/uploads.ts';

const user = Astro.locals.user!;
const profile = getUserAuthorProfile(user.id);
const split = splitDisplayName(user.name);
const saved = Astro.url.searchParams.get('saved') === '1';
const photoUrl = profile?.photo_path ? mediaUrl(profile.photo_path) : user.picture;

const roleLabels: Record<string, string> = {
  super_admin: 'Super Admin',
  admin: 'Admin',
  user: 'Pengguna',
};

const displayName =
  formatContributorName({
    title_prefix: profile?.title_prefix,
    first_name: profile?.first_name ?? split.first,
    middle_name: profile?.middle_name,
    last_name: profile?.last_name ?? split.last,
    title_suffix: profile?.title_suffix,
  }) || user.name || 'Admin';
---

<AdminLayout title="Profil — TRI_LEADCLASS">
  <div class="admin-page max-w-lg mx-auto pb-28 md:pb-8">
    <AdminPageHeader title="Profil Admin" subtitle="Akun panel & biodata redaksi/penulis." />

    {saved && (
      <div class="admin-toast mb-4" role="status">Biodata berhasil disimpan.</div>
    )}

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm admin-card mb-4">
      <div class="flex items-center gap-4">
        {
          user.picture ? (
            <img src={user.picture} alt="" class="h-14 w-14 rounded-full object-cover ring-2 ring-emerald-500/30 shrink-0" />
          ) : (
            <div class="h-14 w-14 rounded-full bg-slate-200 flex items-center justify-center text-xl font-bold text-slate-500 shrink-0">
              {(user.name ?? user.email)[0]?.toUpperCase()}
            </div>
          )
        }
        <div class="min-w-0">
          <p class="font-semibold text-slate-900 truncate">{user.name ?? 'Admin'}</p>
          <p class="text-sm text-slate-500 truncate">{user.email}</p>
          <span class="inline-block mt-1 text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
            {roleLabels[user.role] ?? user.role}
          </span>
        </div>
      </div>
    </div>

    <form id="admin-profile-form" class="space-y-4" enctype="multipart/form-data">
      <div class="admin-card rounded-2xl p-5">
        <div class="flex items-center gap-4 mb-5">
          <div class="relative shrink-0">
            <img
              id="admin-profile-photo"
              src={photoUrl ?? '/icon/icon96.png'}
              alt=""
              class="admin-board-photo rounded-full"
              width="88"
              height="88"
            />
            <label class="admin-profile-photo-edit" aria-label="Ganti foto biodata">
              ✎
              <input
                type="file"
                name="photo"
                accept="image/jpeg,image/png,image/webp"
                data-photo-crop="circle"
                class="hidden"
                id="admin-photo-input"
              />
            </label>
          </div>
          <div class="min-w-0">
            <p class="font-semibold text-slate-900 truncate">{displayName}</p>
            <p class="text-xs text-slate-500 mt-0.5">Biodata tampil di dewan redaksi & profil penulis</p>
          </div>
        </div>

        <p class="text-xs text-slate-400 mb-4">
          Perubahan biodata berlaku untuk semua entri dengan email <strong class="text-slate-600">{user.email}</strong>.
        </p>

        <div class="space-y-3">
          <p class="text-[11px] font-bold uppercase tracking-wide text-slate-400">Nama & identitas</p>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="admin-field-label" for="title_prefix">Gelar awal</label>
              <input type="text" id="title_prefix" name="title_prefix" class="admin-field" value={profile?.title_prefix ?? ''} placeholder="Dr., Prof." />
            </div>
            <div>
              <label class="admin-field-label" for="title_suffix">Gelar akhir</label>
              <input type="text" id="title_suffix" name="title_suffix" class="admin-field" value={profile?.title_suffix ?? ''} placeholder="M.Pd." />
            </div>
          </div>

          <div>
            <label class="admin-field-label" for="first_name">Nama awal *</label>
            <input type="text" id="first_name" name="first_name" required class="admin-field" value={profile?.first_name ?? split.first} autocomplete="given-name" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="admin-field-label" for="middle_name">Nama tengah</label>
              <input type="text" id="middle_name" name="middle_name" class="admin-field" value={profile?.middle_name ?? ''} />
            </div>
            <div>
              <label class="admin-field-label" for="last_name">Nama akhir</label>
              <input type="text" id="last_name" name="last_name" class="admin-field" value={profile?.last_name ?? split.last} autocomplete="family-name" />
            </div>
          </div>

          <div>
            <label class="admin-field-label" for="id_number">NIM / NIDN / NIK</label>
            <input type="text" id="id_number" name="id_number" class="admin-field" value={profile?.id_number ?? ''} inputmode="numeric" />
          </div>
        </div>
      </div>

      <div class="admin-card rounded-2xl p-5 space-y-3">
        <p class="text-[11px] font-bold uppercase tracking-wide text-slate-400">Kontak</p>
        <div>
          <label class="admin-field-label" for="email-display">Email</label>
          <input type="email" id="email-display" class="admin-field bg-slate-50 text-slate-500" value={user.email} readonly tabindex="-1" />
        </div>
        <div>
          <label class="admin-field-label" for="phone">Nomor HP *</label>
          <input type="tel" id="phone" name="phone" required class="admin-field" value={profile?.phone ?? ''} autocomplete="tel" placeholder="08xxxxxxxxxx" />
        </div>
      </div>

      <div class="admin-card rounded-2xl p-5 space-y-3">
        <p class="text-[11px] font-bold uppercase tracking-wide text-slate-400">Afiliasi</p>
        <div>
          <label class="admin-field-label" for="institution">Instansi</label>
          <input type="text" id="institution" name="institution" class="admin-field" value={profile?.institution ?? ''} placeholder="Universitas / lembaga" />
        </div>
        <div>
          <label class="admin-field-label" for="position_status">Jabatan / status</label>
          <input type="text" id="position_status" name="position_status" class="admin-field" value={profile?.position_status ?? ''} placeholder="Dosen, Editor, ..." />
        </div>
      </div>

      <p id="admin-profile-error" class="text-xs text-red-600 hidden px-1" role="alert"></p>

      <div class="admin-profile-save">
        <button type="submit" id="admin-profile-save" class="w-full bg-emerald-600 text-white text-sm font-semibold py-3 rounded-xl hover:bg-emerald-700 transition-colors">
          Simpan biodata
        </button>
      </div>
    </form>
  </div>

  <script>
    function initAdminProfileForm() {
      const form = document.getElementById('admin-profile-form');
      const btn = document.getElementById('admin-profile-save');
      const errEl = document.getElementById('admin-profile-error');
      const photoInput = document.getElementById('admin-photo-input');
      const photoImg = document.getElementById('admin-profile-photo');

      if (!form || form.dataset.bound) return;
      form.dataset.bound = '1';

      function updatePhoto() {
        const file = photoInput?.files?.[0];
        if (file && photoImg) photoImg.src = URL.createObjectURL(file);
      }

      photoInput?.addEventListener('change', updatePhoto);
      photoInput?.addEventListener('tri-photo-cropped', updatePhoto);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn) return;
        btn.disabled = true;
        btn.textContent = 'Menyimpan…';
        errEl?.classList.add('hidden');

        try {
          const res = await fetch('/api/auth/profile', {
            method: 'PATCH',
            body: new FormData(form),
            credentials: 'same-origin',
          });
          const data = await res.json();
          if (res.ok) {
            window.location.href = '/admin/profil?saved=1';
            return;
          }
          if (errEl) {
            errEl.textContent = data.error ?? 'Gagal menyimpan biodata.';
            errEl.classList.remove('hidden');
          }
        } catch {
          if (errEl) {
            errEl.textContent = 'Gagal menghubungi server.';
            errEl.classList.remove('hidden');
          }
        } finally {
          btn.disabled = false;
          btn.textContent = 'Simpan biodata';
        }
      });
    }

    initAdminProfileForm();
    document.addEventListener('astro:page-load', initAdminProfileForm);
    document.addEventListener('astro:after-swap', initAdminProfileForm);
  </script>
</AdminLayout>
