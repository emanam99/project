---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import { formatBoardMemberName, listBoardMembers } from '../../lib/editorial-board.ts';
import { mediaUrl } from '../../lib/uploads.ts';

const members = listBoardMembers();

function photoUrl(path: string | null): string {
  if (path?.startsWith('uploads/')) return mediaUrl(path) ?? '/icon/icon96.png';
  return '/icon/icon96.png';
}

const membersJson = members.map((m) => ({
  id: m.id,
  user_id: m.user_id,
  editorial_role: m.editorial_role,
  title_prefix: m.title_prefix,
  first_name: m.first_name,
  middle_name: m.middle_name,
  last_name: m.last_name,
  title_suffix: m.title_suffix,
  id_number: m.id_number,
  email: m.email,
  phone: m.phone,
  institution: m.institution,
  position_status: m.position_status,
  bio: m.bio,
  sort_order: m.sort_order,
  photo_url: photoUrl(m.photo_path),
}));
---

<AdminLayout title="Dewan Redaksi — Admin">
  <div class="admin-page max-w-4xl mx-auto">
    <AdminPageHeader
      title="Dewan Redaksi"
      subtitle={`${members.length} anggota · tampil di /dewan-redaksi`}
    />

    <button
      type="button"
      id="board-add-btn"
      class="admin-card rounded-2xl w-full p-4 mb-6 text-left font-semibold text-emerald-700 hover:border-emerald-200 transition-colors"
    >
      + Tambah anggota redaksi
    </button>

    <div class="space-y-3">
      {
        members.map((m) => (
          <div class="admin-card rounded-2xl p-4 flex items-center gap-4">
            <img src={photoUrl(m.photo_path)} alt="" class="h-12 w-12 rounded-xl object-cover shrink-0" />
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-slate-900">{formatBoardMemberName(m)}</p>
              <p class="text-xs text-slate-500">{m.editorial_role ?? 'Anggota redaksi'}</p>
              {m.email && (
                <p class="text-[11px] text-slate-400 truncate mt-0.5">
                  {m.email}
                  {m.user_id ? ' · akun tertaut' : ''}
                </p>
              )}
            </div>
            <div class="flex shrink-0 gap-2">
              <button
                type="button"
                class="board-edit-btn text-xs font-semibold text-emerald-700 px-3 py-2 rounded-lg hover:bg-emerald-50"
                data-id={m.id}
              >
                Edit
              </button>
              <button
                type="button"
                class="board-delete-btn text-xs font-semibold text-red-600 px-3 py-2 rounded-lg hover:bg-red-50"
                data-id={m.id}
              >
                Hapus
              </button>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div id="board-backdrop" class="admin-offcanvas-backdrop motion-skip" aria-hidden="true"></div>
  <aside id="board-offcanvas" class="admin-offcanvas motion-skip" aria-hidden="true" aria-labelledby="board-oc-title">
    <div class="admin-offcanvas-head">
      <h2 id="board-oc-title" class="admin-offcanvas-title">Edit Redaksi</h2>
      <button type="button" id="board-oc-close" class="admin-offcanvas-close" aria-label="Tutup">✕</button>
    </div>

    <form id="board-form" class="flex flex-col flex-1 min-h-0" enctype="multipart/form-data">
      <div class="admin-offcanvas-body space-y-3">
        <input type="hidden" name="id" id="board-id" value="" />
        <input type="hidden" name="user_id" id="board-user-id" value="" />

        <div class="flex flex-col items-center gap-2 pb-2">
          <img id="board-photo-preview" src="/icon/icon96.png" alt="" class="admin-board-photo" />
          <label class="text-xs font-semibold text-emerald-700 cursor-pointer">
            Ganti foto
            <input type="file" name="photo" id="board-photo" accept="image/jpeg,image/png,image/webp" data-photo-crop="square" class="hidden" />
          </label>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2 sm:col-span-1">
            <label class="admin-field-label" for="board-role">Peran editorial</label>
            <input type="text" id="board-role" name="editorial_role" class="admin-field" placeholder="Ketua, Sekretaris, …" />
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="admin-field-label" for="board-sort">Urutan tampil</label>
            <input type="number" id="board-sort" name="sort_order" min="1" class="admin-field" />
          </div>
        </div>

        <div>
          <label class="admin-field-label" for="board-email">Email (tautkan ke akun pengguna)</label>
          <div class="flex gap-2">
            <input type="email" id="board-email" name="email" class="admin-field flex-1" placeholder="email@contoh.com" autocomplete="off" />
            <button type="button" id="board-link-btn" class="shrink-0 text-xs font-semibold px-3 rounded-xl bg-slate-800 text-white hover:bg-slate-900">
              Tautkan
            </button>
          </div>
          <p id="board-link-hint" class="admin-link-hint hidden"></p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="admin-field-label" for="board-prefix">Gelar awal</label>
            <input type="text" id="board-prefix" name="title_prefix" class="admin-field" />
          </div>
          <div>
            <label class="admin-field-label" for="board-suffix">Gelar akhir</label>
            <input type="text" id="board-suffix" name="title_suffix" class="admin-field" />
          </div>
        </div>

        <div>
          <label class="admin-field-label" for="board-first">Nama awal *</label>
          <input type="text" id="board-first" name="first_name" required class="admin-field" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="admin-field-label" for="board-middle">Nama tengah</label>
            <input type="text" id="board-middle" name="middle_name" class="admin-field" />
          </div>
          <div>
            <label class="admin-field-label" for="board-last">Nama akhir</label>
            <input type="text" id="board-last" name="last_name" class="admin-field" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="admin-field-label" for="board-phone">Nomor HP</label>
            <input type="tel" id="board-phone" name="phone" class="admin-field" />
          </div>
          <div>
            <label class="admin-field-label" for="board-idnum">NIM / NIDN / NIK</label>
            <input type="text" id="board-idnum" name="id_number" class="admin-field" />
          </div>
        </div>

        <div>
          <label class="admin-field-label" for="board-institution">Instansi</label>
          <input type="text" id="board-institution" name="institution" class="admin-field" value="Universitas At-Taqwa" />
        </div>
        <div>
          <label class="admin-field-label" for="board-position">Jabatan / status</label>
          <input type="text" id="board-position" name="position_status" class="admin-field" />
        </div>
        <div>
          <label class="admin-field-label" for="board-bio">Biodata / riwayat</label>
          <textarea id="board-bio" name="bio" rows="4" class="admin-field"></textarea>
        </div>

        <p id="board-form-error" class="text-xs text-red-600 hidden"></p>
      </div>

      <div class="admin-offcanvas-foot space-y-2">
        <button type="submit" id="board-save-btn" class="w-full bg-emerald-600 text-white text-sm font-semibold py-3 rounded-xl hover:bg-emerald-700">
          Simpan
        </button>
        <button type="button" id="board-delete-oc" class="hidden w-full text-sm font-semibold py-2.5 rounded-xl border border-red-200 text-red-600 hover:bg-red-50">
          Hapus anggota
        </button>
      </div>
    </form>
  </aside>

  <script define:vars={{ membersJson }}>
    const membersById = Object.fromEntries(membersJson.map((m) => [String(m.id), m]));

    function portalOffcanvas() {
      document.querySelectorAll('.admin-offcanvas, .admin-offcanvas-backdrop').forEach((el) => {
        if (el.parentElement !== document.body) document.body.appendChild(el);
      });
    }
    let editMode = false;

    function setHint(text, kind) {
      const linkHint = document.getElementById('board-link-hint');
      if (!linkHint) return;
      if (!text) {
        linkHint.classList.add('hidden');
        linkHint.textContent = '';
        return;
      }
      linkHint.textContent = text;
      linkHint.className = 'admin-link-hint ' + (kind || '');
      linkHint.classList.remove('hidden');
    }

    function closeOffcanvas() {
      const backdrop = document.getElementById('board-backdrop');
      const panel = document.getElementById('board-offcanvas');
      backdrop?.classList.remove('is-open');
      panel?.classList.remove('is-open');
      backdrop?.setAttribute('aria-hidden', 'true');
      panel?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('admin-offcanvas-open');
      panel?.style.removeProperty('transform');
    }

    function openOffcanvas() {
      const backdrop = document.getElementById('board-backdrop');
      const panel = document.getElementById('board-offcanvas');
      backdrop?.classList.add('is-open');
      panel?.classList.add('is-open');
      backdrop?.setAttribute('aria-hidden', 'false');
      panel?.setAttribute('aria-hidden', 'false');
      document.body.classList.add('admin-offcanvas-open');
      if (panel) panel.style.transform = 'translate3d(0, 0, 0)';
    }

    function fillForm(m) {
      const photoPreview = document.getElementById('board-photo-preview');
      const photoInput = document.getElementById('board-photo');
      document.getElementById('board-id').value = m?.id ?? '';
      document.getElementById('board-user-id').value = m?.user_id ?? '';
      document.getElementById('board-role').value = m?.editorial_role ?? '';
      document.getElementById('board-sort').value = m?.sort_order ?? '';
      document.getElementById('board-email').value = m?.email ?? '';
      document.getElementById('board-prefix').value = m?.title_prefix ?? '';
      document.getElementById('board-suffix').value = m?.title_suffix ?? '';
      document.getElementById('board-first').value = m?.first_name ?? '';
      document.getElementById('board-middle').value = m?.middle_name ?? '';
      document.getElementById('board-last').value = m?.last_name ?? '';
      document.getElementById('board-phone').value = m?.phone ?? '';
      document.getElementById('board-idnum').value = m?.id_number ?? '';
      document.getElementById('board-institution').value = m?.institution ?? 'Universitas At-Taqwa';
      document.getElementById('board-position').value = m?.position_status ?? '';
      document.getElementById('board-bio').value = m?.bio ?? '';
      if (photoPreview) photoPreview.src = m?.photo_url ?? '/icon/icon96.png';
      if (photoInput) photoInput.value = '';
      setHint(
        m?.user_id ? 'Akun pengguna tertaut.' : m?.email ? 'Email belum ditautkan ke akun.' : '',
        m?.user_id ? 'ok' : 'warn',
      );
    }

    function openAdd() {
      const titleEl = document.getElementById('board-oc-title');
      const deleteOcBtn = document.getElementById('board-delete-oc');
      const form = document.getElementById('board-form');
      const photoPreview = document.getElementById('board-photo-preview');
      editMode = false;
      if (titleEl) titleEl.textContent = 'Tambah Anggota Redaksi';
      deleteOcBtn?.classList.add('hidden');
      form?.reset();
      document.getElementById('board-id').value = '';
      document.getElementById('board-user-id').value = '';
      document.getElementById('board-institution').value = 'Universitas At-Taqwa';
      if (photoPreview) photoPreview.src = '/icon/icon96.png';
      setHint('', '');
      openOffcanvas();
    }

    function openEdit(id) {
      const m = membersById[String(id)];
      const titleEl = document.getElementById('board-oc-title');
      const deleteOcBtn = document.getElementById('board-delete-oc');
      if (!m) return;
      editMode = true;
      if (titleEl) titleEl.textContent = 'Edit Anggota Redaksi';
      deleteOcBtn?.classList.remove('hidden');
      fillForm(m);
      openOffcanvas();
    }

    async function linkEmail() {
      const email = document.getElementById('board-email')?.value?.trim();
      const photoPreview = document.getElementById('board-photo-preview');
      if (!email) {
        setHint('Masukkan email terlebih dahulu.', 'warn');
        return;
      }
      const excludeId = document.getElementById('board-id')?.value || '';
      const qs = new URLSearchParams({ email });
      if (excludeId) qs.set('exclude_id', excludeId);
      try {
        const res = await fetch('/api/admin/editorial-board?' + qs.toString());
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Gagal');
        const d = json.data;
        if (d.email_taken) {
          setHint('Email sudah dipakai anggota redaksi lain.', 'err');
          document.getElementById('board-user-id').value = '';
          return;
        }
        if (d.user_taken) {
          setHint('Akun pengguna sudah ditautkan ke anggota redaksi lain.', 'err');
          document.getElementById('board-user-id').value = '';
          return;
        }
        if (!d.found) {
          document.getElementById('board-user-id').value = '';
          setHint('Email belum terdaftar sebagai pengguna. Simpan tetap bisa tanpa tautan akun.', 'warn');
          return;
        }
        if (!d.can_link) return;
        document.getElementById('board-user-id').value = String(d.user_id);
        setHint('Akun ditemukan: ' + (d.user_name || d.email) + '. Biodata diisi otomatis bila kosong.', 'ok');
        const p = d.profile;
        if (p) {
          const setIfEmpty = (id, val) => {
            const el = document.getElementById(id);
            if (el && !el.value && val) el.value = val;
          };
          setIfEmpty('board-prefix', p.title_prefix);
          setIfEmpty('board-first', p.first_name);
          setIfEmpty('board-middle', p.middle_name);
          setIfEmpty('board-last', p.last_name);
          setIfEmpty('board-suffix', p.title_suffix);
          setIfEmpty('board-idnum', p.id_number);
          setIfEmpty('board-phone', p.phone);
          setIfEmpty('board-institution', p.institution);
          setIfEmpty('board-position', p.position_status);
          if (photoPreview && photoPreview.src.includes('icon96') && p.photo_path) {
            photoPreview.src = '/api/media/' + p.photo_path.replace(/^uploads\//, '');
          } else if (photoPreview && photoPreview.src.includes('icon96') && p.google_picture) {
            photoPreview.src = p.google_picture;
          }
        }
      } catch (e) {
        setHint(e instanceof Error ? e.message : 'Gagal mengecek email', 'err');
      }
    }

    async function deleteMember(id) {
      if (!confirm('Hapus anggota redaksi ini?')) return;
      const res = await fetch('/api/admin/editorial-board', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(id) }),
      });
      const data = await res.json();
      if (!res.ok) alert(data.error || 'Gagal menghapus');
      else location.reload();
    }

    function initBoardPage() {
      portalOffcanvas();
      document.querySelectorAll('.admin-offcanvas, .admin-offcanvas-backdrop').forEach((el) => {
        el.removeAttribute('data-aos');
        el.removeAttribute('data-aos-delay');
        el.removeAttribute('data-aos-duration');
        el.style.removeProperty('transform');
        el.style.removeProperty('opacity');
      });
      closeOffcanvas();

      const backdrop = document.getElementById('board-backdrop');
      const form = document.getElementById('board-form');
      const photoInput = document.getElementById('board-photo');
      const photoPreview = document.getElementById('board-photo-preview');
      const addBtn = document.getElementById('board-add-btn');
      const closeBtn = document.getElementById('board-oc-close');
      const linkBtn = document.getElementById('board-link-btn');
      const deleteOcBtn = document.getElementById('board-delete-oc');

      if (!form || !form.dataset.boardPage) {
        return;
      }

      if (addBtn && !addBtn.dataset.bound) {
        addBtn.dataset.bound = '1';
        addBtn.addEventListener('click', openAdd);
      }

      document.querySelectorAll('.board-edit-btn').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => openEdit(btn.dataset.id));
      });

      if (closeBtn && !closeBtn.dataset.bound) {
        closeBtn.dataset.bound = '1';
        closeBtn.addEventListener('click', closeOffcanvas);
      }

      if (backdrop && !backdrop.dataset.bound) {
        backdrop.dataset.bound = '1';
        backdrop.addEventListener('click', closeOffcanvas);
      }

      if (linkBtn && !linkBtn.dataset.bound) {
        linkBtn.dataset.bound = '1';
        linkBtn.addEventListener('click', linkEmail);
      }

      if (photoInput && !photoInput.dataset.bound) {
        photoInput.dataset.bound = '1';
        const updatePreview = () => {
          const f = photoInput.files?.[0];
          if (f && photoPreview) photoPreview.src = URL.createObjectURL(f);
        };
        photoInput.addEventListener('change', updatePreview);
        photoInput.addEventListener('tri-photo-cropped', updatePreview);
      }

      if (form && !form.dataset.submitBound) {
        form.dataset.submitBound = '1';
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const errEl = document.getElementById('board-form-error');
          const saveBtn = document.getElementById('board-save-btn');
          errEl?.classList.add('hidden');
          if (saveBtn) saveBtn.disabled = true;

          const fd = new FormData(form);
          const id = fd.get('id');
          const method = id ? 'PATCH' : 'POST';

          try {
            const res = await fetch('/api/admin/editorial-board', { method, body: fd });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Gagal menyimpan');
            location.reload();
          } catch (err) {
            if (errEl) {
              errEl.textContent = err instanceof Error ? err.message : 'Gagal';
              errEl.classList.remove('hidden');
            }
            if (saveBtn) saveBtn.disabled = false;
          }
        });
      }

      if (deleteOcBtn && !deleteOcBtn.dataset.bound) {
        deleteOcBtn.dataset.bound = '1';
        deleteOcBtn.addEventListener('click', () => {
          const id = document.getElementById('board-id')?.value;
          if (id) deleteMember(id);
        });
      }

      document.querySelectorAll('.board-delete-btn').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => deleteMember(btn.dataset.id));
      });
    }

    const boardForm = document.getElementById('board-form');
    if (boardForm) {
      boardForm.dataset.boardPage = '1';
    }

    initBoardPage();
    document.addEventListener('astro:page-load', initBoardPage);
    document.addEventListener('astro:after-swap', initBoardPage);

    if (!document.documentElement.dataset.boardEsc) {
      document.documentElement.dataset.boardEsc = '1';
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeOffcanvas();
      });
    }
  </script>
</AdminLayout>
