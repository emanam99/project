---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Halaman tidak ditemukan — TRI_LEADCLASS">
  <div class="max-w-2xl mx-auto px-4 py-28 text-center">
    <p class="text-7xl font-serif font-black text-emerald-700 mb-4">404</p>
    <h1 class="text-2xl font-serif font-bold text-slate-900 mb-3">Halaman tidak ditemukan</h1>
    <p class="text-gray-600 mb-8">
      Maaf, artikel atau halaman yang Anda cari tidak tersedia atau telah dipindahkan.
    </p>
    <a href="/" class="inline-flex bg-emerald-700 text-white px-6 py-3 rounded-full font-semibold hover:bg-emerald-800 transition-colors">
      Kembali ke Beranda
    </a>
  </div>
</Layout>
