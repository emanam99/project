---
import Layout from '../layouts/Layout.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import StandardArticle from '../components/StandardArticle.astro';
import CompactArticle from '../components/CompactArticle.astro';
import Newsletter from '../components/Newsletter.astro';
import Reveal from '../components/motion/Reveal.astro';
import Icon from '../components/Icon.astro';
import { penulisPortalUrl } from '../lib/portal-urls.ts';
import {
  getFeaturedArticle,
  getLatestArticles,
  getMostViewedArticles,
} from '../lib/articles.ts';

const featured = getFeaturedArticle();
const latest = getLatestArticles(3, featured?.id);
const trending = getMostViewedArticles(4);
const hasArticles = !!(featured || latest.length || trending.length);
---

<Layout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {
      !hasArticles ? (
        <div class="max-w-xl mx-auto text-center py-16 md:py-24">
          <img src="/icon/icon192.png" alt="" class="h-20 w-20 mx-auto mb-6 object-contain opacity-90" />
          <h1 class="text-3xl md:text-4xl font-serif font-black text-slate-900 mb-4">
            TRI_LEADCLASS<span class="text-emerald-700">.</span>
          </h1>
          <p class="text-gray-600 leading-relaxed mb-8">
            Jurnal ilmiah Manajemen Pendidikan Islam — Universitas At-Taqwa.
            Artikel akan tampil di sini setelah diterbitkan oleh redaksi.
          </p>
          <a
            href={penulisPortalUrl('kirimNaskah')}
            class="inline-flex bg-emerald-700 text-white px-6 py-3 rounded-full text-sm font-semibold hover:bg-emerald-800 transition-colors"
          >
            Kirim naskah
          </a>
        </div>
      ) : (
        <>
          {featured && (
            <Reveal animation="fade-up" duration={720}>
              <FeaturedArticle article={featured} />
            </Reveal>
          )}

          <div class="border-t border-gray-200 pt-12 mt-12 grid grid-cols-1 lg:grid-cols-12 gap-12">
            <div class="lg:col-span-8">
              <Reveal animation="fade-up" delay={80}>
                <div class="flex items-center justify-between mb-8">
                  <h3 class="text-2xl font-serif font-bold text-slate-900 flex items-center gap-2">
                    <Icon name="book-open" size={24} class="text-emerald-700" />
                    Riset MPI Terbaru
                  </h3>
                  <a href="/cari" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 flex items-center transition-colors">
                    Lihat semua <Icon name="chevron-right" size={16} />
                  </a>
                </div>
              </Reveal>

              {
                latest.length > 0 ? (
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {latest.map((article, i) => (
                      <Reveal animation="fade-up" delay={120 + i * 90}>
                        <StandardArticle article={article} />
                      </Reveal>
                    ))}
                  </div>
                ) : (
                  <p class="text-gray-500 text-sm">Belum ada artikel terbaru.</p>
                )
              }
            </div>

            <div class="lg:col-span-4 space-y-12">
              {
                trending.length > 0 && (
                  <Reveal animation="fade-up" delay={160}>
                    <div>
                      <h3 class="text-xl font-serif font-bold text-slate-900 mb-6 border-b border-slate-900 pb-2">
                        Banyak Dibaca
                      </h3>
                      <div class="space-y-6">
                        {trending.map((article, index) => (
                          <Reveal animation="fade-left" delay={200 + index * 70}>
                            <CompactArticle article={article} index={index} />
                          </Reveal>
                        ))}
                      </div>
                    </div>
                  </Reveal>
                )
              }

              <Reveal animation="fade-up" delay={240}>
                <Newsletter />
              </Reveal>
            </div>
          </div>
        </>
      )
    }
  </div>
</Layout>
