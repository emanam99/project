---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {
  formatBoardMemberName,
  getBoardMemberPhoto,
  listBoardMembers,
} from '../../lib/editorial-board.ts';
import { mediaUrl } from '../../lib/uploads.ts';

const members = listBoardMembers();

function photoSrc(path: string | null): string {
  if (path?.startsWith('uploads/')) return mediaUrl(path) ?? '/icon/icon96.png';
  return '/icon/icon96.png';
}
---

<Layout
  title="Dewan Redaksi — TRI_LEADCLASS"
  description="Dewan Redaksi TRI_LEADCLASS Journal — Universitas At-Taqwa."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/" class="flex items-center text-sm font-medium text-gray-500 hover:text-emerald-700 mb-8 transition-colors w-fit">
      <Icon name="arrow-left" size={16} class="mr-2" /> Beranda
    </a>

    <header class="mb-12 border-b border-gray-200 pb-8">
      <p class="text-sm font-bold text-emerald-700 uppercase tracking-wider mb-2">Editorial Board</p>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-slate-900">Dewan Redaksi</h1>
      <p class="text-gray-500 mt-3 max-w-2xl leading-relaxed">
        Tim editorial TRI_LEADCLASS Journal yang bertanggung jawab atas proses review, kuratorial, dan
        standar publikasi ilmiah.
      </p>
    </header>

    {
      members.length === 0 ? (
        <p class="text-gray-500 text-center py-16">Profil dewan redaksi akan segera diumumkan.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {
            members.map((m) => (
              <a
                href={`/dewan-redaksi/${m.slug}`}
                class="group flex items-start gap-4 p-5 bg-white border border-gray-100 rounded-2xl hover:border-emerald-200 hover:shadow-md hover:shadow-emerald-900/5 transition-all"
              >
                <img
                  src={photoSrc(getBoardMemberPhoto(m))}
                  alt=""
                  class="h-20 w-20 rounded-xl object-cover ring-2 ring-emerald-50 shrink-0"
                />
                <div class="min-w-0">
                  <p class="font-serif font-bold text-lg text-slate-900 group-hover:text-emerald-800 transition-colors leading-snug">
                    {formatBoardMemberName(m)}
                  </p>
                  {m.editorial_role && (
                    <p class="text-sm text-emerald-700 font-medium mt-1">{m.editorial_role}</p>
                  )}
                  {m.institution && <p class="text-sm text-gray-500 mt-1">{m.institution}</p>}
                </div>
              </a>
            ))
          }
        </div>
      )
    }
  </div>
</Layout>
