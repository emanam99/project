---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { formatPageContent, getSitePageBySlug } from '../../lib/site-pages.ts';

const { slug } = Astro.params;
const page = slug ? getSitePageBySlug(slug) : undefined;

if (!page) {
  return new Response('Halaman tidak ditemukan', { status: 404 });
}

const html = formatPageContent(page.content);
const backLabel = page.section === 'policy' ? 'Kebijakan Jurnal' : 'Edisi Jurnal';
---

<Layout title={`${page.title} — TRI_LEADCLASS`} description={page.excerpt ?? undefined}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/" class="flex items-center text-sm font-medium text-gray-500 hover:text-emerald-700 mb-8 transition-colors w-fit">
      <Icon name="arrow-left" size={16} class="mr-2" /> Beranda
    </a>

    <header class="mb-10 pb-8 border-b border-gray-200">
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-2">{backLabel}</p>
      <h1 class="text-3xl md:text-4xl font-serif font-black text-slate-900 leading-tight">{page.title}</h1>
      {page.excerpt && <p class="text-gray-600 mt-4 leading-relaxed">{page.excerpt}</p>}
    </header>

    <div class="article-body text-slate-700" set:html={html} />

    {
      slug === 'panduan-penulis' && (
        <div class="mt-10 p-6 rounded-2xl bg-emerald-50 border border-emerald-100">
          <p class="text-sm font-semibold text-emerald-900 mb-2">Siap mengirim naskah?</p>
          <p class="text-sm text-emerald-800 mb-4">Masuk ke Portal Penulis untuk mengunggah naskah dan memantau status review.</p>
          <a
            href={import.meta.env.PUBLIC_PENULIS_URL ?? 'https://penulis.trileadclass.my.id'}
            class="inline-flex items-center gap-2 bg-emerald-700 text-white text-sm font-semibold px-5 py-2.5 rounded-full hover:bg-emerald-800 transition-colors"
          >
            Buka Portal Penulis
          </a>
        </div>
      )
    }
  </article>
</Layout>
