---
import Layout from '../layouts/Layout.astro';
import StandardArticle from '../components/StandardArticle.astro';
import Icon from '../components/Icon.astro';
import { searchArticles, listArticles } from '../lib/articles.ts';

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const results = query ? searchArticles(query) : listArticles(12);
---

<Layout title={query ? `Pencarian: ${query} — TRI_LEADCLASS` : 'Telusuri — TRI_LEADCLASS'}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-serif font-black text-slate-900 mb-6">Telusuri Jurnal</h1>
      <form method="get" action="/cari" class="relative max-w-2xl">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
          <Icon name="search" size={20} />
        </span>
        <input
          type="search"
          name="q"
          value={query}
          placeholder="Cari judul, penulis, atau kata kunci riset..."
          class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
        />
      </form>
    </header>

    <p class="text-gray-500 mb-8">
      {
        query
          ? `${results.length} hasil untuk "${query}"`
          : `Menampilkan ${results.length} artikel terbaru`
      }
    </p>

    {
      results.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {results.map((article) => <StandardArticle article={article} />)}
        </div>
      ) : (
        <p class="text-gray-500">Tidak ada artikel yang cocok dengan pencarian Anda.</p>
      )
    }
  </div>
</Layout>
