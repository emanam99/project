---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Reveal from '../../components/motion/Reveal.astro';
import { getArticleBySlug, incrementViews } from '../../lib/articles.ts';
import { toParagraphs, formatViewCount, articleTitleClass } from '../../lib/utils.ts';

const { slug } = Astro.params;
const article = slug ? getArticleBySlug(slug) : undefined;

if (!article) {
  return new Response('Artikel tidak ditemukan', { status: 404 });
}

incrementViews(article.id);
const viewCount = article.views + 1;

const paragraphs = toParagraphs(article.content);
const titleClass = articleTitleClass(article.title, 'hero');
const tags = [article.category_name].filter(Boolean) as string[];
const metaDescription = article.excerpt ?? paragraphs[0] ?? undefined;
---

<Layout title={`${article.title} — TRI_LEADCLASS`} description={metaDescription}>
  <article class="bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-6">
      <Reveal animation="fade-down" duration={500}>
        <a href="/" class="flex items-center text-sm font-medium text-gray-500 hover:text-emerald-700 mb-8 transition-colors w-fit">
          <Icon name="arrow-left" size={16} class="mr-2" /> Kembali ke Beranda
        </a>
      </Reveal>

      <Reveal animation="fade-up" delay={80}>
        <div class="text-center mb-8">
          {article.category_name && (
            <a href={`/kategori/${article.category_slug}`} class="text-sm font-bold text-emerald-700 uppercase tracking-wider mb-4 block">
              {article.category_name}
            </a>
          )}
          <h1 class:list={[titleClass, 'mb-0']}>
            {article.title}
          </h1>
        </div>
      </Reveal>

      <Reveal animation="fade-up" delay={140}>
        <div class="flex items-center justify-between py-6 border-y border-gray-200">
          <div class="flex items-center gap-4 min-w-0">
            <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center font-serif font-bold text-emerald-700 text-xl shrink-0">
              {article.author_name?.charAt(0)}
            </div>
            <div class="text-left min-w-0">
              <div class="font-bold text-slate-900 truncate">{article.author_name}</div>
              <div class="text-xs text-gray-500">{article.author_role}</div>
            </div>
          </div>
          <div class="flex items-center gap-3 sm:gap-4 text-gray-400 shrink-0">
            <div class="text-sm text-right hidden sm:block">
              <span class="block text-slate-700 font-medium">{article.published_at}</span>
              <span class="text-xs">{article.read_time}</span>
            </div>
            <div class="flex items-center gap-1.5 text-sm text-slate-600" title="Jumlah pembaca">
              <Icon name="eye" size={18} class="text-gray-400 shrink-0" />
              <span>{formatViewCount(viewCount)}</span>
            </div>
            <div class="flex gap-1">
              <button
                type="button"
                id="article-bookmark"
                class="article-action-btn p-2 hover:bg-emerald-50 rounded-full hover:text-emerald-700 transition-colors text-gray-400"
                aria-label="Simpan artikel"
                aria-pressed="false"
                title="Simpan artikel"
              >
                <Icon name="bookmark" size={20} />
              </button>
              <button
                type="button"
                id="article-share"
                class="article-action-btn p-2 hover:bg-emerald-50 rounded-full hover:text-emerald-700 transition-colors text-gray-400"
                aria-label="Bagikan artikel"
                title="Bagikan artikel"
              >
                <Icon name="share" size={20} />
              </button>
            </div>
          </div>
        </div>
        <p id="article-action-toast" class="text-center text-xs font-medium text-emerald-700 mt-2 opacity-0 transition-opacity duration-300" role="status" aria-live="polite"></p>
      </Reveal>
    </div>

    {article.image && (
      <Reveal animation="zoom-in" delay={180}>
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
          <img src={article.image} alt={article.title} class="w-full h-[400px] md:h-[600px] object-cover rounded-2xl shadow-sm" />
        </div>
      </Reveal>
    )}

    <Reveal animation="fade-up" delay={220}>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
        <div class="article-body max-w-none font-serif text-lg text-gray-800">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        {
          tags.length > 0 && (
            <div class="mt-10 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-md">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </Reveal>
  </article>
</Layout>

<script define:vars={{ articleSlug: slug, articleTitle: article.title }}>
  const BOOKMARK_KEY = 'tri_saved_articles';

  function pageSlug() {
    const match = window.location.pathname.match(/\/artikel\/([^/?#]+)/);
    return match ? decodeURIComponent(match[1]) : articleSlug;
  }

  function pageTitle() {
    return document.querySelector('article h1')?.textContent?.trim() || articleTitle;
  }

  function getSavedSlugs() {
    try {
      const raw = localStorage.getItem(BOOKMARK_KEY);
      const list = raw ? JSON.parse(raw) : [];
      return Array.isArray(list) ? list.filter((s) => typeof s === 'string') : [];
    } catch {
      return [];
    }
  }

  function setSavedSlugs(slugs) {
    localStorage.setItem(BOOKMARK_KEY, JSON.stringify(slugs));
  }

  function showToast(msg) {
    const toast = document.getElementById('article-action-toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.style.opacity = '1';
    window.clearTimeout(showToast._timer);
    showToast._timer = window.setTimeout(() => {
      toast.style.opacity = '0';
    }, 2600);
  }

  function syncBookmarkBtn() {
    const btn = document.getElementById('article-bookmark');
    if (!btn) return;
    const saved = getSavedSlugs().includes(pageSlug());
    btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
    btn.classList.toggle('is-saved', saved);
    btn.title = saved ? 'Hapus dari simpanan' : 'Simpan artikel';
  }

  function initArticleActions() {
    const bookmarkBtn = document.getElementById('article-bookmark');
    const shareBtn = document.getElementById('article-share');

    syncBookmarkBtn();

    if (bookmarkBtn && !bookmarkBtn.dataset.bound) {
      bookmarkBtn.dataset.bound = '1';
      bookmarkBtn.addEventListener('click', () => {
        const slug = pageSlug();
        const slugs = getSavedSlugs();
        const idx = slugs.indexOf(slug);
        if (idx >= 0) {
          slugs.splice(idx, 1);
          setSavedSlugs(slugs);
          showToast('Artikel dihapus dari simpanan.');
        } else {
          slugs.unshift(slug);
          setSavedSlugs(slugs.slice(0, 100));
          showToast('Artikel disimpan di perangkat ini.');
        }
        syncBookmarkBtn();
      });
    }

    if (shareBtn && !shareBtn.dataset.bound) {
      shareBtn.dataset.bound = '1';
      shareBtn.addEventListener('click', async () => {
        const url = window.location.href;
        const shareData = { title: pageTitle(), url };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
            return;
          } catch (err) {
            if (err && err.name === 'AbortError') return;
          }
        }

        try {
          await navigator.clipboard.writeText(url);
          showToast('Tautan artikel disalin.');
        } catch {
          window.prompt('Salin tautan artikel:', url);
        }
      });
    }
  }

  initArticleActions();
  document.addEventListener('astro:page-load', initArticleActions);
  document.addEventListener('astro:after-swap', initArticleActions);
</script>

<style>
  .article-action-btn.is-saved {
    color: #059669;
    background: #ecfdf5;
  }

  .article-action-btn.is-saved svg {
    fill: currentColor;
  }
</style>
