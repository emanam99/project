---
import '../styles/photo-crop.css';
---

<div id="tri-photo-crop" class="photo-crop motion-skip" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Editor foto">
  <div class="photo-crop-backdrop"></div>
  <div class="photo-crop-shell">
    <header class="photo-crop-head">
      <button type="button" class="photo-crop-head-btn" data-crop-cancel>Batal</button>
      <span class="photo-crop-title" data-crop-title>Sesuaikan foto</span>
      <button type="button" class="photo-crop-head-btn photo-crop-head-btn--done" data-crop-done>Selesai</button>
    </header>

    <div class="photo-crop-stage" data-crop-stage>
      <canvas class="photo-crop-canvas" data-crop-canvas aria-hidden="true"></canvas>
      <div class="photo-crop-dim photo-crop-dim-top" data-crop-dim-top aria-hidden="true"></div>
      <div class="photo-crop-dim photo-crop-dim-bottom" data-crop-dim-bottom aria-hidden="true"></div>
      <div class="photo-crop-dim photo-crop-dim-left" data-crop-dim-left aria-hidden="true"></div>
      <div class="photo-crop-dim photo-crop-dim-right" data-crop-dim-right aria-hidden="true"></div>
      <div class="photo-crop-frame photo-crop-frame--square" data-crop-frame></div>
    </div>

    <footer class="photo-crop-tools">
      <button type="button" class="photo-crop-tool-btn" data-crop-rotate-ccw aria-label="Putar kiri">↺</button>
      <button type="button" class="photo-crop-tool-btn" data-crop-zoom-out aria-label="Perkecil">−</button>
      <input type="range" class="photo-crop-zoom" data-crop-zoom min="1" max="3" step="0.02" value="1" aria-label="Zoom" />
      <button type="button" class="photo-crop-tool-btn" data-crop-zoom-in aria-label="Perbesar">+</button>
      <button type="button" class="photo-crop-tool-btn" data-crop-rotate-cw aria-label="Putar kanan">↻</button>
    </footer>
  </div>
</div>

<script>
  import { initPhotoCropSystem } from '../lib/photo-crop.ts';

  initPhotoCropSystem();
  document.addEventListener('astro:page-load', initPhotoCropSystem);
  document.addEventListener('astro:after-swap', initPhotoCropSystem);
</script>
