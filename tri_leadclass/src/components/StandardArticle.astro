---
import type { Article } from '../lib/types.ts';
import { articleTitleClass, formatViewCount } from '../lib/utils.ts';
import Icon from './Icon.astro';

interface Props { article: Article }
const { article } = Astro.props;
const href = `/artikel/${article.slug}`;
const titleClass = articleTitleClass(article.title, 'card');
---

<article class="group flex flex-col h-full">
  <a href={href} class="overflow-hidden rounded-lg mb-4 block">
    <img
      src={article.image}
      alt={article.title}
      loading="lazy"
      class="w-full h-48 object-cover transform group-hover:scale-105 transition-transform duration-500"
    />
  </a>
  <div class="flex-1 flex flex-col">
    {article.category_name && (
      <a href={`/kategori/${article.category_slug}`} class="text-xs font-bold text-emerald-700 uppercase tracking-wider mb-2">
        {article.category_name}
      </a>
    )}
    <a href={href}>
      <h3 class:list={[titleClass, 'mb-3 group-hover:underline decoration-2 decoration-emerald-700 underline-offset-4']}>
        {article.title}
      </h3>
    </a>
    <p class="text-gray-600 text-sm mb-4 line-clamp-3 flex-1">{article.excerpt}</p>
    <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between gap-2 text-xs text-gray-500">
      <span class="font-medium text-slate-800 truncate">{article.author_name}</span>
      <div class="flex items-center gap-3 shrink-0">
        <span class="hidden sm:inline">{article.published_at}</span>
        <span class="flex items-center gap-1 text-slate-600" title="Jumlah pembaca">
          <Icon name="eye" size={14} class="text-gray-400 shrink-0" />
          {formatViewCount(article.views)}
        </span>
      </div>
    </div>
  </div>
</article>
