---
import '../../styles/motion.css';
---

<script>
  import AOS from 'aos';
  import 'aos/dist/aos.css';
  import { AOS_DEFAULTS } from '../../lib/motion.ts';

  let aosReady = false;

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function stripAos() {
    document.querySelectorAll('[data-aos]').forEach((el) => {
      el.removeAttribute('data-aos');
      el.removeAttribute('data-aos-delay');
      el.removeAttribute('data-aos-duration');
      el.classList.add('motion-reveal-static');
    });
  }

  function autoRevealSections() {
    if (prefersReducedMotion()) return;

    const roots = '.site-main-inner, .author-page-inner, .admin-main-inner';
    document.querySelectorAll(roots).forEach((root) => {
      root.querySelectorAll(':scope > *').forEach((el, i) => {
        if (el.hasAttribute('data-aos') || el.classList.contains('motion-reveal')) return;
        if (el.classList.contains('admin-offcanvas') || el.classList.contains('admin-offcanvas-backdrop')) return;
        if (el.classList.contains('motion-skip')) return;
        el.setAttribute('data-aos', 'fade-up');
        el.setAttribute('data-aos-delay', String(Math.min(i * 50, 250)));
      });
    });
  }

  function initScrollMotion() {
    if (prefersReducedMotion()) {
      stripAos();
      return;
    }

    autoRevealSections();

    if (!aosReady) {
      AOS.init({ ...AOS_DEFAULTS });
      aosReady = true;
      return;
    }

    AOS.refreshHard();
  }

  initScrollMotion();

  document.addEventListener('astro:page-load', initScrollMotion);
  document.addEventListener('astro:after-swap', () => {
    window.requestAnimationFrame(initScrollMotion);
  });
</script>
