---
import type { Article } from '../lib/types.ts';
import { articleTitleClass, formatViewCount } from '../lib/utils.ts';
import Icon from './Icon.astro';

interface Props { article: Article }
const { article } = Astro.props;
const href = `/artikel/${article.slug}`;
const titleClass = articleTitleClass(article.title, 'featured');
---

<article class="group mb-16">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
    <div class="order-2 lg:order-1">
      {article.category_name && (
        <a href={`/kategori/${article.category_slug}`} class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider rounded-full mb-4 hover:bg-emerald-100 transition-colors">
          {article.category_name}
        </a>
      )}
      <a href={href} class="block">
        <h2 class:list={[titleClass, 'mb-4 group-hover:text-emerald-700 transition-colors']}>
          {article.title}
        </h2>
      </a>
      <p class="text-lg text-gray-600 mb-6 leading-relaxed">{article.excerpt}</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
        <div class="flex flex-col">
          <span class="font-semibold text-slate-900">{article.author_name}</span>
          <span class="text-gray-500">{article.published_at} · {article.read_time}</span>
        </div>
        <div class="flex items-center gap-1.5 text-slate-600" title="Jumlah pembaca">
          <Icon name="eye" size={16} class="text-gray-400 shrink-0" />
          <span class="text-sm">{formatViewCount(article.views)}</span>
        </div>
      </div>
    </div>
    <a href={href} class="order-1 lg:order-2 overflow-hidden rounded-xl shadow-lg block">
      <img
        src={article.image}
        alt={article.title}
        loading="lazy"
        class="w-full h-[300px] lg:h-[450px] object-cover transform group-hover:scale-105 transition-transform duration-700 ease-in-out"
      />
    </a>
  </div>
</article>
