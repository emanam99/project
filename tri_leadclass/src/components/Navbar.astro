---
import Icon from './Icon.astro';
import { getAllCategories } from '../lib/articles.ts';
import { penulisPortalUrl } from '../lib/portal-urls.ts';

const categories = getAllCategories();
const user = Astro.locals.user;
const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-200/90">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center gap-2 sm:gap-4 min-h-16 md:h-[5.25rem] py-1.5 md:py-0">
      <!-- Kiri: logo + identitas -->
      <a href="/" class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1 leading-none group" aria-label="TRI_LEADCLASS — Beranda">
        <span class="site-header-logo" aria-hidden="true">
          <img
            src="/icon/icon.png"
            alt=""
            width="56"
            height="56"
          />
        </span>
        <div class="min-w-0 text-left">
          <span class="block text-lg sm:text-xl md:text-3xl font-serif font-black tracking-widest text-slate-900 uppercase leading-tight">
            TRI_LEADCLASS<span class="text-emerald-700">.</span>
          </span>
          <span class="site-header-tagline mt-0.5 block text-[8px] sm:text-[9px] md:text-[11px] uppercase text-gray-400 font-semibold">
            Universitas At-Taqwa<span class="hidden sm:inline"> · </span><br class="sm:hidden" aria-hidden="true" />Angkatan ke-3 · Kelas B
          </span>
        </div>
      </a>

      <!-- Kanan: aksi + pencarian -->
      <div class="flex items-center justify-end gap-2 sm:gap-4 md:gap-6 shrink-0">
        <a
          href="/cari"
          class="hidden md:inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-emerald-700 transition-colors"
        >
          <Icon name="search" size={20} />
          Telusuri
        </a>
        {
          user ? (
            <a href={penulisPortalUrl('home')} class="hidden md:inline text-sm font-medium text-gray-500 hover:text-emerald-700 transition-colors">
              Portal Penulis
            </a>
          ) : null
        }
        <a
          href={penulisPortalUrl('kirimNaskah')}
          class="hidden md:inline text-sm font-medium text-gray-500 hover:text-emerald-700 transition-colors"
        >
          Kirim Naskah
        </a>
        <a href="/cari" class="md:hidden p-2 text-gray-500 hover:text-emerald-700" aria-label="Telusuri">
          <Icon name="search" size={22} />
        </a>
      </div>
    </div>

    <!-- Navigasi kategori (desktop) -->
    <nav class="hidden md:flex justify-center items-center flex-wrap gap-x-8 gap-y-2 py-3 border-t border-gray-100" aria-label="Kategori jurnal">
      <a
        href="/penulis"
        class="text-xs uppercase tracking-widest font-semibold text-gray-500 hover:text-emerald-700 transition-colors"
      >
        Penulis
      </a>
      {
        categories.map((category) => (
          <a
            href={`/kategori/${category.slug}`}
            class="text-xs uppercase tracking-widest font-semibold text-gray-500 hover:text-emerald-700 transition-colors"
          >
            {category.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<!-- Bottom bar — HP saja -->
<nav class="site-mobile-bar md:hidden" aria-label="Navigasi bawah">
  <a href="/" class:list={['site-mobile-bar-link', isActive('/') && 'active']}>
    <span class="site-mobile-bar-icon"><Icon name="home" size={20} /></span>
    Beranda
  </a>
  <a href="/cari" class:list={['site-mobile-bar-link', isActive('/cari') && 'active']}>
    <span class="site-mobile-bar-icon"><Icon name="search" size={20} /></span>
    Cari
  </a>
  <button
    type="button"
    id="site-sidebar-open"
    class="site-mobile-bar-link site-mobile-bar-menu"
    aria-label="Buka menu navigasi"
    aria-expanded="false"
    aria-controls="site-sidebar"
  >
    <span class="site-mobile-bar-icon"><Icon name="menu" size={20} /></span>
    Menu
  </button>
  <a href="/penulis" class:list={['site-mobile-bar-link', isActive('/penulis') && 'active']}>
    <span class="site-mobile-bar-icon"><Icon name="users" size={20} /></span>
    Penulis
  </a>
  <a href={penulisPortalUrl('kirimNaskah')} class="site-mobile-bar-link">
    <span class="site-mobile-bar-icon"><Icon name="send" size={20} /></span>
    Kirim
  </a>
</nav>

<!-- Sidebar kanan — HP saja -->
<div id="site-sidebar" class="site-sidebar md:hidden" aria-hidden="true">
  <div id="site-sidebar-backdrop" class="site-sidebar-backdrop" aria-hidden="true"></div>
  <aside class="site-sidebar-panel" aria-label="Menu navigasi">
    <div class="site-sidebar-head">
      <div class="site-sidebar-brand">
        <span class="site-header-logo site-header-logo--sm" aria-hidden="true">
          <img src="/icon/icon.png" alt="" width="36" height="36" />
        </span>
        <div class="min-w-0">
          <p class="site-sidebar-brand-name">TRI_LEADCLASS</p>
          <p class="site-sidebar-brand-sub">Jurnal MPI</p>
        </div>
      </div>
      <button type="button" id="site-sidebar-close" class="site-sidebar-close" aria-label="Tutup menu">
        <Icon name="x" size={18} />
      </button>
    </div>

    <div class="site-sidebar-body">
      <div class="site-sidebar-section">
        <p class="site-sidebar-section-title">Jelajahi</p>
        <a href="/" class="site-sidebar-link">
          <span class="site-sidebar-link-icon"><Icon name="home" size={18} /></span>
          Beranda
        </a>
        <a href="/cari" class="site-sidebar-link">
          <span class="site-sidebar-link-icon"><Icon name="search" size={18} /></span>
          Telusuri artikel
        </a>
        <a href="/penulis" class="site-sidebar-link">
          <span class="site-sidebar-link-icon"><Icon name="users" size={18} /></span>
          Daftar penulis
        </a>
      </div>

      {
        categories.length > 0 && (
          <div class="site-sidebar-section">
            <p class="site-sidebar-section-title">Kategori</p>
            {
              categories.map((category) => (
                <a href={`/kategori/${category.slug}`} class="site-sidebar-link">
                  <span class="site-sidebar-link-icon">
                    <Icon name="book-open" size={18} />
                  </span>
                  {category.name}
                </a>
              ))
            }
          </div>
        )
      }

      <div class="site-sidebar-divider"></div>

      <div class="site-sidebar-section">
        <p class="site-sidebar-section-title">Penulis</p>
        {
          user && (
            <a href={penulisPortalUrl('home')} class="site-sidebar-link">
              <span class="site-sidebar-link-icon"><Icon name="home" size={18} /></span>
              Portal penulis
            </a>
          )
        }
        <a href={penulisPortalUrl('kirimNaskah')} class="site-sidebar-link">
          <span class="site-sidebar-link-icon"><Icon name="send" size={18} /></span>
          Kirim naskah
        </a>
      </div>
    </div>
  </aside>
</div>

<script>
  function openSidebar() {
    const sidebar = document.getElementById('site-sidebar');
    const openBtn = document.getElementById('site-sidebar-open');
    sidebar?.classList.add('is-open');
    sidebar?.setAttribute('aria-hidden', 'false');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('site-sidebar-open');
  }

  function closeSidebar() {
    const sidebar = document.getElementById('site-sidebar');
    const openBtn = document.getElementById('site-sidebar-open');
    sidebar?.classList.remove('is-open');
    sidebar?.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('site-sidebar-open');
  }

  function initSiteNav() {
    const sidebar = document.getElementById('site-sidebar');
    const openBtn = document.getElementById('site-sidebar-open');
    const closeBtn = document.getElementById('site-sidebar-close');
    const backdrop = document.getElementById('site-sidebar-backdrop');

    if (openBtn && !openBtn.dataset.bound) {
      openBtn.dataset.bound = '1';
      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openSidebar();
      });
    }

    if (closeBtn && !closeBtn.dataset.bound) {
      closeBtn.dataset.bound = '1';
      closeBtn.addEventListener('click', closeSidebar);
    }

    if (backdrop && !backdrop.dataset.bound) {
      backdrop.dataset.bound = '1';
      backdrop.addEventListener('click', closeSidebar);
    }

    if (sidebar && !sidebar.dataset.linksBound) {
      sidebar.dataset.linksBound = '1';
      sidebar.querySelectorAll('[data-sidebar-close], a.site-sidebar-link').forEach((el) => {
        el.addEventListener('click', closeSidebar);
      });
    }
  }

  initSiteNav();
  document.addEventListener('astro:page-load', initSiteNav);
  document.addEventListener('astro:after-swap', initSiteNav);

  if (!document.documentElement.dataset.siteNavEsc) {
    document.documentElement.dataset.siteNavEsc = '1';
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.getElementById('site-sidebar')?.classList.contains('is-open')) {
        closeSidebar();
      }
    });
  }
</script>
