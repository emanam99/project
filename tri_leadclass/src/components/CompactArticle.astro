---
import type { Article } from '../lib/types.ts';
import { articleTitleClass, formatViewCount } from '../lib/utils.ts';
import Icon from './Icon.astro';

interface Props { article: Article; index: number }
const { article, index } = Astro.props;
const rank = String(index + 1).padStart(2, '0');
const titleClass = articleTitleClass(article.title, 'compact');
---

<a href={`/artikel/${article.slug}`} class="group flex gap-4 items-start">
  <span class="text-3xl font-serif font-bold text-gray-200">{rank}</span>
  <div>
    <h4 class:list={[titleClass, 'leading-snug mb-1 group-hover:text-emerald-700 transition-colors']}>
      {article.title}
    </h4>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-gray-500">
      <span>{article.author_name}</span>
      <span class="text-gray-300" aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1 text-slate-600" title="Jumlah pembaca">
        <Icon name="eye" size={13} class="text-gray-400 shrink-0" />
        {formatViewCount(article.views)}
      </span>
    </div>
  </div>
</a>
