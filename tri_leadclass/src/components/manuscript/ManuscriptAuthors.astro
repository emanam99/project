---
import type { User, UserAuthorProfile } from '../../lib/types.ts';
import { formatContributorName, splitDisplayName } from '../../lib/contributors.ts';
import { mediaUrl } from '../../lib/uploads.ts';

interface Props {
  user: User;
  profile?: UserAuthorProfile;
}

const { user, profile } = Astro.props;
const split = splitDisplayName(user.name);

const initialPrimary = {
  title_prefix: profile?.title_prefix ?? '',
  first_name: profile?.first_name ?? split.first,
  middle_name: profile?.middle_name ?? '',
  last_name: profile?.last_name ?? split.last,
  title_suffix: profile?.title_suffix ?? '',
  id_number: profile?.id_number ?? '',
  email: user.email,
  phone: profile?.phone ?? '',
  institution: profile?.institution ?? '',
  position_status: profile?.position_status ?? '',
  photo_preview: profile?.photo_path ? mediaUrl(profile.photo_path) : user.picture,
};

const primaryDisplayName =
  formatContributorName({
    title_prefix: initialPrimary.title_prefix,
    first_name: initialPrimary.first_name,
    middle_name: initialPrimary.middle_name,
    last_name: initialPrimary.last_name,
    title_suffix: initialPrimary.title_suffix,
  }) || user.name || user.email;
---

<div class="space-y-4 mb-8">
  <div class="border border-gray-200 rounded-xl p-5 bg-white">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div>
        <h2 class="text-lg font-serif font-bold text-slate-900">Daftar Penulis</h2>
        <p class="text-xs text-gray-500">Penulis utama + maks. 20 penulis tambahan</p>
      </div>
      <button
        type="button"
        id="add-coauthor-btn"
        class="shrink-0 text-sm font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-full transition-colors"
      >
        + Tambah Penulis
      </button>
    </div>

    <ul id="author-list" class="space-y-2">
      <li id="primary-author-row" class="flex items-center gap-3 p-3 bg-emerald-50/60 rounded-lg border border-emerald-100">
        <img id="primary-list-photo" src={initialPrimary.photo_preview ?? '/icon/icon96.png'} alt="" class="h-10 w-10 rounded-full object-cover bg-white ring-2 ring-emerald-100" />
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-bold uppercase text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full">Utama</span>
          </div>
          <p id="primary-list-name" class="font-semibold text-sm text-slate-900 truncate">{primaryDisplayName}</p>
          <p id="primary-list-meta" class="text-xs text-gray-500 truncate">{user.email}{initialPrimary.phone ? ` · ${initialPrimary.phone}` : ''}</p>
        </div>
        <button type="button" id="edit-primary-btn" class="text-xs text-emerald-700 font-semibold px-2 py-1 hover:underline">Edit</button>
      </li>
    </ul>
    <p id="coauthor-empty" class="text-sm text-gray-400 text-center py-3 hidden">Belum ada penulis tambahan.</p>
  </div>
</div>

<!-- Offcanvas di luar form (komponen dipasang di luar <form> di halaman induk) -->
<div id="author-backdrop" class="author-ms-backdrop fixed inset-0 bg-black/40 z-[300] hidden opacity-0 transition-opacity duration-300" aria-hidden="true"></div>
<aside
  id="author-offcanvas"
  class="author-ms-offcanvas fixed top-0 right-0 h-[100dvh] w-full max-w-md bg-white z-[310] shadow-2xl translate-x-full transition-transform duration-300 flex flex-col"
  aria-hidden="true"
>
  <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 shrink-0">
    <h3 id="offcanvas-title" class="font-serif font-bold text-slate-900">Penulis</h3>
    <button type="button" id="offcanvas-close" class="p-2 text-gray-500 hover:text-slate-900 text-xl leading-none" aria-label="Tutup">✕</button>
  </div>

  <div class="flex-1 overflow-y-auto p-5 space-y-3">
    <!-- Langkah email (co-author baru) -->
    <div id="co-email-step" class="hidden space-y-3">
      <p class="text-sm text-gray-600">Masukkan email penulis terlebih dahulu. Jika sudah terdaftar, biodata terisi otomatis.</p>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1">Email *</label>
        <input type="email" id="co-email-only" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm" placeholder="email@contoh.com" />
      </div>
      <button type="button" id="co-email-check" class="w-full bg-slate-800 text-white text-sm font-semibold py-2.5 rounded-xl hover:bg-slate-900">Lanjutkan</button>
      <p id="co-email-hint" class="text-xs text-emerald-700 hidden"></p>
    </div>

    <!-- Form biodata -->
    <div id="author-detail-step" class="space-y-3">
      <div id="locked-notice" class="hidden text-xs bg-amber-50 border border-amber-100 text-amber-900 rounded-lg p-3">
        Profil dari database — hanya pemilik akun yang dapat mengubah biodata ini.
      </div>

      <div class="flex flex-col items-center gap-2 mb-2">
        <img id="oc-photo-preview" src="/icon/icon96.png" alt="" class="h-16 w-16 rounded-full object-cover bg-gray-100 ring-2 ring-gray-100" />
        <label id="oc-photo-label" class="text-xs text-emerald-700 font-semibold cursor-pointer">
          Upload foto
          <input type="file" id="oc-photo" accept="image/jpeg,image/png,image/webp" class="hidden" />
        </label>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2 oc-email-row">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Email *</label>
          <input type="email" id="oc-email" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Gelar awal</label>
          <input type="text" id="oc-prefix" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Gelar akhir</label>
          <input type="text" id="oc-suffix" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Nama awal *</label>
          <input type="text" id="oc-first" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Nama tengah</label>
          <input type="text" id="oc-middle" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Nama akhir</label>
          <input type="text" id="oc-last" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label class="block text-xs font-semibold text-gray-600 mb-1">NIM / NIDN / NIK</label>
          <input type="text" id="oc-idnum" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Nomor HP *</label>
          <input type="tel" id="oc-phone" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Instansi</label>
          <input type="text" id="oc-institution" class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div class="col-span-2">
          <label class="block text-xs font-semibold text-gray-600 mb-1">Jabatan / status</label>
          <input type="text" id="oc-position" placeholder="Mahasiswa, Dosen, ..." class="oc-field w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        </div>
      </div>
      <p id="oc-error" class="text-xs text-red-600 hidden"></p>
    </div>
  </div>

  <div id="oc-footer" class="author-ms-offcanvas-foot p-5 border-t border-gray-200 shrink-0">
    <button type="button" id="oc-save" class="w-full bg-emerald-700 text-white font-semibold py-2.5 rounded-xl hover:bg-emerald-800">Simpan</button>
  </div>
</aside>

<script is:inline define:vars={{ initialPrimary, userEmail: user.email }}>
  (function () {
    const MAX_CO = 20;
    /** @type {'primary'|'co-new'|'co-edit'} */
    let mode = 'primary';
    let editIndex = null;
    let fieldsLocked = false;
    let ocPhotoFile = null;
    let primaryPhotoFile = null;

    /** @type {Record<string, string> & { photo_preview?: string|null }} */
    let primaryAuthor = { ...initialPrimary };

    /** @type {Array<Record<string, string> & { photoFile?: File|null, photoPreview?: string|null, locked?: boolean }>} */
    let coAuthors = [];

    const backdrop = document.getElementById('author-backdrop');
    const offcanvas = document.getElementById('author-offcanvas');
    const authorList = document.getElementById('author-list');
    const coEmpty = document.getElementById('coauthor-empty');
    const emailStep = document.getElementById('co-email-step');
    const detailStep = document.getElementById('author-detail-step');
    const footer = document.getElementById('oc-footer');
    const lockedNotice = document.getElementById('locked-notice');

    function portalAuthorOffcanvas() {
      [backdrop, offcanvas].forEach(function (el) {
        if (el && el.parentElement !== document.body) document.body.appendChild(el);
      });
    }
    portalAuthorOffcanvas();

    function formatName(a) {
      const parts = [a.title_prefix, a.first_name, a.middle_name, a.last_name].filter(Boolean);
      let n = parts.join(' ');
      if (a.title_suffix) n += ', ' + a.title_suffix;
      return n || 'Penulis';
    }

    function photoUrl(path) {
      if (!path) return '/icon/icon96.png';
      if (path.startsWith('http') || path.startsWith('/')) return path;
      return '/api/media/' + path.replace(/^uploads\//, '');
    }

    function setField(id, value, readonly) {
      const el = document.getElementById(id);
      if (!el) return;
      el.value = value || '';
      el.readOnly = !!readonly;
      el.classList.toggle('bg-gray-50', !!readonly);
      el.classList.toggle('cursor-not-allowed', !!readonly);
    }

    function setAllFieldsReadonly(locked) {
      fieldsLocked = locked;
      document.querySelectorAll('.oc-field').forEach(function (el) {
        if (el.id === 'oc-email') return;
        el.readOnly = locked;
        el.classList.toggle('bg-gray-50', locked);
        el.classList.toggle('cursor-not-allowed', locked);
      });
      const photoLabel = document.getElementById('oc-photo-label');
      if (photoLabel) photoLabel.classList.toggle('hidden', locked);
      if (lockedNotice) lockedNotice.classList.toggle('hidden', !locked);
    }

    function readFields() {
      return {
        title_prefix: document.getElementById('oc-prefix').value.trim(),
        first_name: document.getElementById('oc-first').value.trim(),
        middle_name: document.getElementById('oc-middle').value.trim(),
        last_name: document.getElementById('oc-last').value.trim(),
        title_suffix: document.getElementById('oc-suffix').value.trim(),
        id_number: document.getElementById('oc-idnum').value.trim(),
        email: document.getElementById('oc-email').value.trim().toLowerCase(),
        phone: document.getElementById('oc-phone').value.trim(),
        institution: document.getElementById('oc-institution').value.trim(),
        position_status: document.getElementById('oc-position').value.trim(),
      };
    }

    function fillFields(data, locked) {
      setField('oc-prefix', data.title_prefix, locked);
      setField('oc-first', data.first_name, locked);
      setField('oc-middle', data.middle_name, locked);
      setField('oc-last', data.last_name, locked);
      setField('oc-suffix', data.title_suffix, locked);
      setField('oc-idnum', data.id_number, locked);
      setField('oc-email', data.email, true);
      setField('oc-phone', data.phone, locked);
      setField('oc-institution', data.institution, locked);
      setField('oc-position', data.position_status, locked);
      setAllFieldsReadonly(locked);
      const preview = document.getElementById('oc-photo-preview');
      if (preview) preview.src = photoUrl(data.photo_preview || data.photoPreview);
    }

    function openOffcanvas() {
      portalAuthorOffcanvas();
      if (backdrop) backdrop.classList.remove('hidden');
      document.body.classList.add('author-offcanvas-open');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        backdrop && backdrop.classList.remove('opacity-0');
        offcanvas && offcanvas.classList.remove('translate-x-full');
      });
    }

    function closeOffcanvas() {
      backdrop && backdrop.classList.add('opacity-0');
      offcanvas && offcanvas.classList.add('translate-x-full');
      document.body.classList.remove('author-offcanvas-open');
      setTimeout(function () {
        backdrop && backdrop.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
      const err = document.getElementById('oc-error');
      if (err) err.classList.add('hidden');
      ocPhotoFile = null;
    }

    function openPrimaryEdit() {
      mode = 'primary';
      editIndex = null;
      fieldsLocked = false;
      ocPhotoFile = null;
      document.getElementById('offcanvas-title').textContent = 'Edit Penulis Utama';
      emailStep && emailStep.classList.add('hidden');
      detailStep && detailStep.classList.remove('hidden');
      footer && footer.classList.remove('hidden');
      fillFields(primaryAuthor, false);
      setField('oc-email', userEmail, true);
      setAllFieldsReadonly(false);
      if (lockedNotice) lockedNotice.classList.add('hidden');
      openOffcanvas();
    }

    function openCoNew() {
      mode = 'co-new';
      editIndex = null;
      fieldsLocked = false;
      ocPhotoFile = null;
      document.getElementById('offcanvas-title').textContent = 'Tambah Penulis';
      emailStep && emailStep.classList.remove('hidden');
      detailStep && detailStep.classList.add('hidden');
      footer && footer.classList.add('hidden');
      document.getElementById('co-email-only').value = '';
      document.getElementById('co-email-hint').classList.add('hidden');
      openOffcanvas();
    }

    function openCoEdit(index) {
      mode = 'co-edit';
      editIndex = index;
      const data = coAuthors[index];
      fieldsLocked = !!data.locked;
      ocPhotoFile = null;
      document.getElementById('offcanvas-title').textContent = 'Edit Penulis';
      emailStep && emailStep.classList.add('hidden');
      detailStep && detailStep.classList.remove('hidden');
      footer && footer.classList.remove('hidden');
      fillFields(data, fieldsLocked);
      openOffcanvas();
    }

    function showDetailFromEmail(email) {
      emailStep && emailStep.classList.add('hidden');
      detailStep && detailStep.classList.remove('hidden');
      footer && footer.classList.remove('hidden');
      fillFields({ email: email }, false);
      setField('oc-email', email, true);
    }

    function updatePrimaryList() {
      document.getElementById('primary-list-name').textContent = formatName(primaryAuthor);
      document.getElementById('primary-list-meta').textContent =
        primaryAuthor.email + (primaryAuthor.phone ? ' · ' + primaryAuthor.phone : '');
      const img = document.getElementById('primary-list-photo');
      if (img) img.src = photoUrl(primaryAuthor.photo_preview);
    }

    function renderCoList() {
      if (!authorList) return;
      authorList.querySelectorAll('[data-coauthor]').forEach(function (el) { el.remove(); });
      coAuthors.forEach(function (a, i) {
        const li = document.createElement('li');
        li.setAttribute('data-coauthor', String(i));
        li.className = 'flex items-center gap-3 p-3 bg-gray-50 rounded-lg border border-gray-100';
        li.innerHTML =
          '<img src="' + photoUrl(a.photoPreview || a.photo_preview) + '" alt="" class="h-10 w-10 rounded-full object-cover bg-white" />' +
          '<div class="flex-1 min-w-0"><p class="font-semibold text-sm text-slate-900 truncate">' + formatName(a) + '</p>' +
          '<p class="text-xs text-gray-500 truncate">' + a.email + ' · ' + a.phone + (a.locked ? ' · <span class="text-amber-600">Profil terdaftar</span>' : '') + '</p></div>' +
          '<button type="button" data-edit-co="' + i + '" class="text-xs text-emerald-700 font-semibold px-2 py-1">Edit</button>' +
          '<button type="button" data-remove-co="' + i + '" class="text-xs text-red-600 font-semibold px-2 py-1">Hapus</button>';
        authorList.appendChild(li);
      });
      if (coEmpty) coEmpty.classList.toggle('hidden', coAuthors.length > 0);

      authorList.querySelectorAll('[data-edit-co]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          openCoEdit(Number(btn.getAttribute('data-edit-co')));
        });
      });
      authorList.querySelectorAll('[data-remove-co]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          coAuthors.splice(Number(btn.getAttribute('data-remove-co')), 1);
          renderCoList();
        });
      });
    }

    document.getElementById('edit-primary-btn')?.addEventListener('click', openPrimaryEdit);
    document.getElementById('add-coauthor-btn')?.addEventListener('click', function () {
      if (coAuthors.length >= MAX_CO) {
        alert('Maksimal ' + MAX_CO + ' penulis tambahan.');
        return;
      }
      openCoNew();
    });
    document.getElementById('offcanvas-close')?.addEventListener('click', closeOffcanvas);
    backdrop?.addEventListener('click', closeOffcanvas);

    document.getElementById('co-email-check')?.addEventListener('click', async function () {
      const email = document.getElementById('co-email-only').value.trim().toLowerCase();
      const hint = document.getElementById('co-email-hint');
      if (!email) return;
      if (email === userEmail.toLowerCase()) {
        alert('Anda sudah terdaftar sebagai penulis utama.');
        return;
      }
      if (coAuthors.some(function (a) { return a.email.toLowerCase() === email; })) {
        alert('Email sudah ada di daftar penulis.');
        return;
      }
      try {
        const res = await fetch('/api/auth/lookup-author?email=' + encodeURIComponent(email));
        const json = await res.json();
        const d = json.data || {};
        showDetailFromEmail(email);
        if (d.found && d.complete && d.locked) {
          fillFields(d, true);
          fieldsLocked = true;
          if (hint) {
            hint.textContent = 'Profil ditemukan — biodata terkunci.';
            hint.classList.remove('hidden');
          }
        } else if (d.found) {
          fillFields(d, false);
          fieldsLocked = false;
          if (hint) {
            hint.textContent = 'Profil ditemukan — lengkapi atau perbaiki data.';
            hint.classList.remove('hidden');
          }
        } else {
          fillFields({ email: email }, false);
          fieldsLocked = false;
          if (hint) {
            hint.textContent = 'Email belum terdaftar — isi biodata manual.';
            hint.classList.remove('hidden');
          }
        }
      } catch (e) {
        showDetailFromEmail(email);
      }
    });

    document.getElementById('oc-photo')?.addEventListener('change', async function (e) {
      if (fieldsLocked) return;
      const input = e.target;
      const file = input.files && input.files[0];
      if (!file) return;
      input.value = '';

      var finalFile = file;
      if (window.triPhotoCrop && window.triPhotoCrop.open) {
        var cropped = await window.triPhotoCrop.open(file, { aspect: 'circle', title: 'Sesuaikan foto penulis' });
        if (!cropped) return;
        finalFile = cropped;
      }

      if (mode === 'primary') {
        primaryPhotoFile = finalFile;
      } else {
        ocPhotoFile = finalFile;
      }
      document.getElementById('oc-photo-preview').src = URL.createObjectURL(finalFile);
    });

    document.getElementById('oc-save')?.addEventListener('click', function () {
      const err = document.getElementById('oc-error');
      const data = readFields();

      if (!data.first_name) {
        if (err) { err.textContent = 'Nama awal wajib diisi.'; err.classList.remove('hidden'); }
        return;
      }
      if (!data.phone) {
        if (err) { err.textContent = 'Nomor HP wajib diisi.'; err.classList.remove('hidden'); }
        return;
      }

      if (mode === 'primary') {
        primaryAuthor = Object.assign({}, data, {
          email: userEmail,
          photo_preview: ocPhotoFile ? URL.createObjectURL(ocPhotoFile) : primaryAuthor.photo_preview,
        });
        if (ocPhotoFile) primaryPhotoFile = ocPhotoFile;
        updatePrimaryList();
        closeOffcanvas();
        return;
      }

      if (!data.email) {
        if (err) { err.textContent = 'Email wajib diisi.'; err.classList.remove('hidden'); }
        return;
      }

      const entry = Object.assign({}, data, {
        locked: fieldsLocked,
        photoFile: fieldsLocked ? null : ocPhotoFile,
        photoPreview: ocPhotoFile
          ? URL.createObjectURL(ocPhotoFile)
          : document.getElementById('oc-photo-preview').src,
      });

      if (mode === 'co-edit' && editIndex !== null) {
        coAuthors[editIndex] = entry;
      } else {
        coAuthors.push(entry);
      }
      renderCoList();
      closeOffcanvas();
    });

    window.__manuscriptAuthors = {
      getPrimary: function () { return Object.assign({}, primaryAuthor); },
      getCoAuthors: function () { return coAuthors.slice(); },
      getPrimaryPhotoFile: function () { return primaryPhotoFile; },
    };

    updatePrimaryList();
    renderCoList();
  })();
</script>
