---
import '../styles/global.css';
import '../styles/site-nav.css';
import '../styles/motion.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MotionScripts from '../components/motion/MotionScripts.astro';
import { ClientRouter } from 'astro:transitions';
import { sitePageTransition } from '../lib/motion.ts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TRI_LEADCLASS — Jurnal Manajemen Pendidikan Islam',
  description = 'Jurnal ilmiah riset unggulan, kajian teoritis, dan praktik terbaik dalam ruang lingkup Manajemen Pendidikan Islam.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon/icon512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon/icon192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icon/icon96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon/icon32.png" />
    <link rel="apple-touch-icon" href="/icon/icon192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-white text-slate-900 selection:bg-emerald-100 selection:text-emerald-900 site-body-mobile">
    <Navbar transition:animate="none" />
    <main class="flex-grow" transition:animate="none">
      <div class="site-main-inner" transition:name="site-main" transition:animate={sitePageTransition}>
        <slot />
      </div>
    </main>
    <Footer transition:animate="none" />
    <MotionScripts />
  </body>
</html>
