---
import '../styles/global.css';
import '../styles/portal.css';
import '../styles/author.css';
import '../styles/motion.css';
import ProfileMenu from '../components/portal/ProfileMenu.astro';
import PortalScripts from '../components/portal/PortalScripts.astro';
import MotionScripts from '../components/motion/MotionScripts.astro';
import PhotoCropEditor from '../components/PhotoCropEditor.astro';
import { ClientRouter } from 'astro:transitions';
import { portalPageTransition } from '../lib/motion.ts';
import { getAdminUrl } from '../lib/auth.ts';
import { isAdminRole } from '../lib/users.ts';
import { portalRoute, type PortalRoute } from '../lib/portal-urls.ts';

interface Props {
  title?: string;
  /** Halaman tanpa shell (mis. gate login) */
  bare?: boolean;
}

const { title = 'Portal Penulis — TRI_LEADCLASS', bare = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const onPenulis = Astro.locals.isPenulisHost;
const siteHome = (import.meta.env.PUBLIC_SITE_URL ?? 'https://trileadclass.my.id').replace(/\/$/, '');
const adminDashboardUrl = `${getAdminUrl()}/admin`;
const showAdminLink = user ? isAdminRole(user.role) : false;

type NavItem = { route: PortalRoute; label: string; icon: string };

const navItems: NavItem[] = [
  { route: 'home', label: 'Dashboard', icon: 'home' },
  { route: 'kirimNaskah', label: 'Kirim Naskah', icon: 'send' },
  { route: 'published', label: 'Published', icon: 'published' },
  { route: 'profil', label: 'Profil', icon: 'user' },
];

function navHref(route: PortalRoute): string {
  return portalRoute(route, onPenulis);
}

function isActive(route: PortalRoute): boolean {
  const href = navHref(route);
  if (route === 'home') {
    return onPenulis ? path === '/' || path === '' : path === '/akun' || path === '/akun/';
  }
  return path === href || path.startsWith(`${href}/`);
}

const icons: Record<string, string> = {
  home: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  send: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" x2="12" y1="18" y2="12"/><line x1="9" x2="15" y1="15" y2="15"/>',
  published: '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>',
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  chevron: '<path d="m15 18-6-6 6-6"/>',
  admin: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
};

const showShell = user && !bare;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#059669" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon/icon512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon/icon192.png" />
    <link rel="apple-touch-icon" href="/icon/icon192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {showShell && <ClientRouter />}
  </head>
  <body class="font-sans text-slate-900 antialiased">
    {
      showShell ? (
        <div class="author-shell portal-shell" id="author-shell" data-sidebar-collapsed="false">
          <aside
            class="author-sidebar hidden md:flex fixed inset-y-0 left-0 z-40 flex-col bg-emerald-950 text-white border-r border-emerald-900/80"
            aria-label="Navigasi penulis"
          >
            <div class="flex items-center justify-between gap-2 p-4 border-b border-emerald-900/80">
              <a href={navHref('home')} class="flex items-center gap-3 min-w-0 overflow-hidden">
                <img src="/icon/icon.png" alt="" class="h-9 w-9 object-contain shrink-0" />
                <div class="author-brand-text transition-opacity duration-200 min-w-0">
                  <p class="font-serif font-black text-xs tracking-widest uppercase truncate">TRI_LEADCLASS</p>
                  <p class="text-[10px] text-emerald-300/90 uppercase tracking-wider">Portal Penulis</p>
                </div>
              </a>
              <button
                type="button"
                id="author-sidebar-toggle"
                class="shrink-0 p-2 rounded-lg text-emerald-300/80 hover:text-white hover:bg-emerald-900/80 transition-colors"
                aria-label="Ciutkan sidebar"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chevron} />
              </button>
            </div>

            <nav class="flex-1 p-3 space-y-1">
              {
                navItems.map((item) => (
                  <a
                    href={navHref(item.route)}
                    title={item.label}
                    class:list={[
                      'author-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-emerald-100/90 hover:text-white hover:bg-emerald-900/60 transition-colors',
                      isActive(item.route) && 'active !text-emerald-200 !bg-emerald-900/50',
                    ]}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" set:html={icons[item.icon]} />
                    <span class="author-nav-label transition-opacity duration-200">{item.label}</span>
                  </a>
                ))
              }
            </nav>

            <div class="p-3 border-t border-emerald-900/80 space-y-1">
              {
                showAdminLink && (
                  <a
                    href={adminDashboardUrl}
                    class="author-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm text-emerald-200/90 hover:text-white hover:bg-emerald-900/60 transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" set:html={icons.admin} />
                    <span class="author-nav-label">Panel Admin</span>
                  </a>
                )
              }
              <a href={siteHome} class="author-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm text-emerald-300/80 hover:text-white hover:bg-emerald-900/60">
                <span class="author-nav-label">← Beranda Jurnal</span>
              </a>
            </div>
          </aside>

          <div class="author-main-wrap min-h-screen flex flex-col">
            <header class="portal-header">
              <div class="min-w-0 flex-1 md:hidden">
                <p class="author-header-mobile-title portal-text-title">{title.replace(' — TRI_LEADCLASS', '')}</p>
              </div>
              <div class="hidden md:block min-w-0">
                <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 portal-text-muted">Portal Penulis</p>
                <p class="text-sm font-semibold text-slate-900 portal-text-title truncate">{title.replace(' — TRI_LEADCLASS', '')}</p>
              </div>
              {user && (
                <ProfileMenu
                  user={user}
                  id="author-profile-menu"
                  adminHref={showAdminLink ? adminDashboardUrl : undefined}
                />
              )}
            </header>

            <main class="author-page author-main flex-1" transition:animate="none">
              <div class="author-page-inner" transition:name="portal-main" transition:animate={portalPageTransition}>
                <slot />
              </div>
            </main>
          </div>

          <nav
            class="author-bottom-nav md:hidden fixed bottom-0 inset-x-0 z-50 flex items-stretch justify-around bg-white/95 backdrop-blur-lg border-t border-slate-200/90 shadow-[0_-4px_24px_rgba(15,23,42,0.06)]"
            aria-label="Navigasi bawah penulis"
          >
            {
              navItems.map((item) => (
                <a
                  href={navHref(item.route)}
                  class:list={[
                    'author-bottom-link flex flex-1 flex-col items-center justify-center gap-0.5 py-2 text-[10px] font-semibold text-slate-500 transition-colors',
                    isActive(item.route) && 'active',
                  ]}
                >
                  <span class="author-bottom-icon flex h-8 w-8 items-center justify-center rounded-xl transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
                  </span>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      ) : (
        <div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-emerald-50">
          {bare && (
            <header class="portal-header">
              <a href={siteHome} class="flex items-center gap-2 text-sm font-semibold text-emerald-700">← Beranda</a>
            </header>
          )}
          <slot />
        </div>
      )
    }

    <PortalScripts />
    <PhotoCropEditor />
    <MotionScripts />

    {
      showShell && (
        <script is:inline>
          (function () {
            var shell = document.getElementById('author-shell');
            var toggle = document.getElementById('author-sidebar-toggle');
            var KEY = 'tri_author_sidebar_collapsed';
            if (!shell || !toggle) return;
            if (localStorage.getItem(KEY) === 'true') shell.setAttribute('data-sidebar-collapsed', 'true');
            toggle.addEventListener('click', function () {
              var collapsed = shell.getAttribute('data-sidebar-collapsed') === 'true';
              shell.setAttribute('data-sidebar-collapsed', collapsed ? 'false' : 'true');
              localStorage.setItem(KEY, collapsed ? 'false' : 'true');
            });
          })();
        </script>
      )
    }
  </body>
</html>
