AddDefaultCharset UTF-8

# Header keamanan & CSP (selaras Daftar/eBeddien). img-src memuat api.qrserver.com untuk QR iPayMu/QRIS.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset Permissions-Policy
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://alutsmani.id https://*.alutsmani.id https://api.qrserver.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' data:; connect-src 'self' https://alutsmani.id https://*.alutsmani.id https://api.qrserver.com ws: wss:; manifest-src 'self'; worker-src 'self' blob:; frame-src 'none'; form-action 'self'; upgrade-insecure-requests"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://alutsmani.id https://*.alutsmani.id https://api.qrserver.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' data:; connect-src 'self' https://alutsmani.id https://*.alutsmani.id https://api.qrserver.com ws: wss:; manifest-src 'self'; worker-src 'self' blob:; frame-src 'none'; form-action 'self'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^(sw\.js|pwa-release\.txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} ^/(robots\.txt|sitemap\.xml)$ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|json|webmanifest|webp|map|txt)$ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_URI} ^/(assets|gambar|workbox|dev-dist)/ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
