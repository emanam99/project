DB_HOST=127.0.0.1
DB_NAME=kasly
DB_USER=root
DB_PASS=
# DB_PORT=3306
# Cloud SQL / App Engine: isi unix socket, contoh /cloudsql/PROJECT:REGION:INSTANCE
# DB_SOCKET=

# Google OAuth (pola sama SPPG)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL frontend setelah login Google (dev Vite atau build)
FRONTEND_URL=http://localhost:5178

# Redirect URI yang didaftarkan di Google Cloud Console
# Contoh lokal: http://localhost/kasly/api/public/auth/google/callback
# Contoh App Engine: https://YOUR-PROJECT.appspot.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost/kasly/api/public/auth/google/callback

# Email yang otomatis jadi super_admin saat login pertama
SUPER_ADMIN_EMAIL=em.anam999@gmail.com

# Origin frontend yang diizinkan (CORS + credentials). Pisahkan koma jika lebih dari satu.
CORS_ORIGINS=http://localhost:5178,http://localhost

# Folder penyimpanan lampiran (default: api/uploads)
# UPLOADS_PATH=

# --- Production contoh ---
# FRONTEND_URL=https://kasly.example.com
# GOOGLE_REDIRECT_URI=https://kasly.example.com/api/public/auth/google/callback
# CORS_ORIGINS=https://kasly.example.com
