DB_HOST=127.0.0.1
DB_NAME=sppg
DB_USER=root
DB_PASS=

# Google OAuth (sama pola tri_leadclass)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL frontend setelah login Google (dev Vite atau build XAMPP)
FRONTEND_URL=http://localhost:5177

# Redirect URI yang didaftarkan di Google Cloud Console — WAJIB localhost
# (Google menolak IP privat seperti 192.168.x.x tanpa device_id)
# Contoh: http://localhost/sppg/api/public/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost/sppg/api/public/auth/google/callback

# Email admin utama — otomatis super_admin saat login (semua tenant)
SUPER_ADMIN_EMAIL=em.anam999@gmail.com

# Origin frontend yang diizinkan (CORS + credentials). Pisahkan koma jika lebih dari satu.
# IP LAN privat (192.168 / 10 / 172.16-31) otomatis diizinkan untuk akses HP lokal.
CORS_ORIGINS=http://localhost:5177,http://localhost,http://192.168.1.4:5177

# Akses dari HP (Wi‑Fi sama):
# 1) npm run dev (Vite listen 0.0.0.0)
# 2) Buka http://<IP-PC>:5177 di HP
# 3) Daftarkan di Google Cloud Console (Authorized redirect URIs):
#    http://localhost/sppg/api/public/auth/google/callback
#    http://<IP-PC>/sppg/api/public/auth/google/callback
# 4) Pastikan firewall Windows mengizinkan port 80 dan 5177

# Rekening debet BNI Direct untuk ekspor CSV sheet Online (maker)
# Production: WAJIB diisi — dipakai sebagai rekening debet utama di baris header batch
BNI_DEBIT_ACCOUNT=5268080020354800

# Auto-approve dari email BNI (IMAP Gmail App Password untuk mbeddien@gmail.com)
BNI_CRON_KEY=ganti-dengan-rahasia
BNI_NOTIFY_IMAP_HOST=imap.gmail.com
BNI_NOTIFY_IMAP_PORT=993
BNI_NOTIFY_IMAP_USER=mbeddien@gmail.com
BNI_NOTIFY_IMAP_PASS=
BNI_NOTIFY_IMAP_FOLDER=INBOX

# Folder penyimpanan lampiran belanja (default: api/uploads)
# UPLOADS_PATH=C:/xampp/htdocs/sppg/api/uploads

# --- Google Cloud Console (OAuth 2.0 Client) ---
# Authorized redirect URIs (callback):
#   Dev lokal:
#     http://localhost/sppg/api/public/auth/google/callback
#   Production alutsmani:
#     https://sppg.alutsmani.id/api/public/auth/google/callback
#   Production cloudy (callback pusat — satu URI untuk landing + tenant):
#     https://sppg.cloudy.my.id/api/public/auth/google/callback
#
# Authorized JavaScript origins (contoh):
#   http://localhost:5177
#   http://localhost
#   https://sppg.alutsmani.id
#   https://sppg.cloudy.my.id
#   https://sppgalutsmani.cloudy.my.id
#   https://<subdomain-tenant>.cloudy.my.id  (tambah per tenant bila perlu)

# --- Production (sppg.alutsmani.id) contoh ---
# FRONTEND_URL=https://sppg.alutsmani.id
# GOOGLE_REDIRECT_URI=https://sppg.alutsmani.id/api/public/auth/google/callback
# CORS_ORIGINS=https://sppg.alutsmani.id
# SUPER_ADMIN_EMAIL=em.anam999@gmail.com

# --- Production cloudy.my.id (multi-tenant subdomain) ---
# FRONTEND_URL=https://sppg.cloudy.my.id
# GOOGLE_REDIRECT_URI=https://sppg.cloudy.my.id/api/public/auth/google/callback
# CORS_ORIGINS=https://sppg.cloudy.my.id
# SUPER_ADMIN_EMAIL=em.anam999@gmail.com
# TENANT_BASE_DOMAIN=cloudy.my.id
# LANDING_HOST=sppg.cloudy.my.id
# HOSTINGER_PROVISION_ENABLED=1
# HOSTINGER_ACCOUNT_USERNAME=u264984103
# HOSTINGER_DOMAIN=cloudy.my.id
# HOSTINGER_SUBDOMAIN_DIRECTORY=sppg
# HOSTINGER_API_TOKEN=
# BNI_DEBIT_ACCOUNT=5268080020354800
# Cron: GET /api/public/cron/bni-email-poll?key=BNI_CRON_KEY tiap 5 menit
# Daftarkan GOOGLE_REDIRECT_URI production di Google Cloud Console.