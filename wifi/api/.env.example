DB_HOST=127.0.0.1
DB_NAME=wifi
DB_USER=root
DB_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL frontend setelah login Google (dev Vite atau build XAMPP)
FRONTEND_URL=http://localhost:5178

# Redirect URI yang didaftarkan di Google Cloud Console — WAJIB localhost
# Contoh: http://localhost/wifi/api/public/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost/wifi/api/public/auth/google/callback

# Email yang otomatis jadi super_admin saat login (tidak tampil di daftar pengguna)
SUPER_ADMIN_EMAIL=em.anam999@gmail.com

# Origin frontend yang diizinkan (CORS + credentials). Pisahkan koma jika lebih dari satu.
CORS_ORIGINS=http://localhost:5178,http://localhost

# Fallback login email/password (production awal / tanpa Google). Kosongkan di lokal bila tidak dipakai.
# FALLBACK_ADMIN_EMAIL=admin@wifi.cloudy.my.id
# FALLBACK_ADMIN_PASSWORD=

# Kunci cron generate tagihan berulang (GET/POST /cron/tagihan-bulanan?key=)
# TAGIHAN_CRON_KEY=
