---
/** Daftar semua berita publish (SSR ringan, supaya selalu fresh). */
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import SmartImage from '../../components/SmartImage.astro'
import { fetchBeritaList, fetchKategoriBerita } from '../../lib/api'

const url = new URL(Astro.request.url)
const page = Math.max(1, Number(url.searchParams.get('page') || '1'))
const q = url.searchParams.get('q')?.trim() || undefined

const [berita, kategori] = await Promise.all([
  fetchBeritaList({ page, limit: 12, q }),
  fetchKategoriBerita()
])
---

<Layout title="Berita" description="Daftar berita & informasi pondok pesantren.">
  <header class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <h1 class="text-2xl font-bold">Berita</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Kabar terbaru dari pondok.</p>
    </div>
    <form method="get" class="flex gap-2">
      <input
        type="search"
        name="q"
        value={q || ''}
        placeholder="Cari berita…"
        class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"
      />
      <button class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Cari</button>
    </form>
  </header>

  {kategori && kategori.length > 0 && (
    <nav class="mb-6 flex flex-wrap gap-2">
      {kategori.filter((k) => Number(k.aktif)).map((k) => (
        <a
          href={`/kategori/${k.slug}`}
          class="rounded-full border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800"
        >
          {k.nama}
        </a>
      ))}
    </nav>
  )}

  {(!berita || berita.length === 0) ? (
    <p class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-slate-500 dark:border-slate-700">
      Belum ada berita.
    </p>
  ) : (
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {berita.map((b) => (
        <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
          <a href={`/berita/${b.slug}`} class="block">
            <SmartImage src={b.cover_url} alt={b.judul} class="aspect-[16/9] w-full object-cover" />
            <div class="space-y-2 p-4">
              {b.kategori_nama && (
                <span class="inline-block rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-900/30 dark:text-brand-500">
                  {b.kategori_nama}
                </span>
              )}
              <h2 class="line-clamp-2 text-base font-semibold">{b.judul}</h2>
              {b.ringkasan && <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-300">{b.ringkasan}</p>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}

  <nav class="mt-8 flex items-center justify-between text-sm">
    {page > 1 ? (
      <a href={`/berita?page=${page - 1}${q ? `&q=${encodeURIComponent(q)}` : ''}`} class="rounded-md border px-3 py-1">
        ← Sebelumnya
      </a>
    ) : <span></span>}
    {berita && berita.length === 12 && (
      <a href={`/berita?page=${page + 1}${q ? `&q=${encodeURIComponent(q)}` : ''}`} class="rounded-md border px-3 py-1">
        Selanjutnya →
      </a>
    )}
  </nav>
</Layout>
