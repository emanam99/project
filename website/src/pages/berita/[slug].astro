---
/** Detail berita per slug — SSR (selalu fresh, status 404 jika tidak ditemukan). */
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import SmartImage from '../../components/SmartImage.astro'
import { fetchBeritaBySlug } from '../../lib/api'
import { htmlToText } from '../../lib/seo'

const slug = (Astro.params.slug as string) || ''
const berita = slug ? await fetchBeritaBySlug(slug) : null

if (!berita) {
  return new Response('Berita tidak ditemukan', { status: 404 })
}

const description = berita.ringkasan || htmlToText(berita.konten_html, 160) || null
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || '').replace(/\/$/, '')
const canonical = `${siteUrl}/berita/${berita.slug}`

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: berita.judul,
  description,
  image: berita.og_image || berita.cover_url || undefined,
  datePublished: berita.published_at || undefined,
  dateModified: berita.updated_at || berita.published_at || undefined,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: berita.author_nama ? { '@type': 'Person', name: berita.author_nama } : undefined
}
---

<Layout
  title={berita.judul}
  description={description}
  ogTitle={berita.og_title || berita.judul}
  ogDescription={berita.og_description || description}
  ogImage={berita.og_image || berita.cover_url}
  type="article"
  publishedTime={berita.published_at}
  jsonLd={jsonLd}
>
  <article class="space-y-6">
    <header class="space-y-3">
      {berita.kategori_nama && (
        <a
          href={`/kategori/${berita.kategori_slug || ''}`}
          class="inline-block rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-900/30 dark:text-brand-500"
        >
          {berita.kategori_nama}
        </a>
      )}
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white md:text-3xl">{berita.judul}</h1>
      <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
        {berita.author_nama && <span>oleh {berita.author_nama}</span>}
        {berita.published_at && <span>· {String(berita.published_at).slice(0, 10)}</span>}
      </div>
    </header>

    {berita.cover_url && (
      <SmartImage
        src={berita.cover_url}
        alt={berita.judul}
        class="aspect-[16/9] w-full rounded-xl object-cover"
        loading="eager"
      />
    )}

    {berita.ringkasan && (
      <p class="text-base text-slate-600 italic dark:text-slate-300">{berita.ringkasan}</p>
    )}

    {berita.konten_html && (
      <div class="prose-pesantren" set:html={berita.konten_html} />
    )}

    <footer class="border-t border-slate-200 pt-4 text-sm dark:border-slate-800">
      <a href="/berita" class="text-brand-700 hover:underline dark:text-brand-500">← Kembali ke daftar berita</a>
    </footer>
  </article>
</Layout>
