---
/**
 * Beranda (prerender on, dibuat statis di build; gunakan revalidate eksternal jika perlu).
 * Tampilkan banner aktif + daftar berita terbaru.
 */
export const prerender = true

import Layout from '../layouts/Layout.astro'
import SmartImage from '../components/SmartImage.astro'
import { fetchBanner, fetchBeritaList, fetchKategoriBerita } from '../lib/api'

const [banners, berita, kategori] = await Promise.all([
  fetchBanner(),
  fetchBeritaList({ limit: 9 }),
  fetchKategoriBerita()
])
---

<Layout title="Beranda" description="Berita & informasi terbaru pondok pesantren.">
  {banners && banners.length > 0 && (
    <section class="mb-10 overflow-hidden rounded-2xl">
      <div class="relative aspect-[16/7] w-full">
        <SmartImage src={banners[0].gambar_url} alt={banners[0].judul} class="absolute inset-0 h-full w-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-5 text-white md:p-8">
          <h1 class="text-xl font-bold md:text-3xl">{banners[0].judul}</h1>
          {banners[0].link_url && (
            <a href={banners[0].link_url} class="mt-3 inline-flex rounded-full bg-white/90 px-4 py-1.5 text-sm font-medium text-slate-900 hover:bg-white">
              Selengkapnya →
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {kategori && kategori.length > 0 && (
    <section class="mb-8 flex flex-wrap gap-2">
      <a href="/berita" class="rounded-full border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800">
        Semua
      </a>
      {kategori.filter((k) => Number(k.aktif)).slice(0, 8).map((k) => (
        <a href={`/kategori/${k.slug}`} class="rounded-full border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800">
          {k.nama}
        </a>
      ))}
    </section>
  )}

  <section>
    <header class="mb-4 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Berita terbaru</h2>
      <a href="/berita" class="text-sm text-brand-700 hover:underline dark:text-brand-500">Lihat semua →</a>
    </header>

    {(!berita || berita.length === 0) ? (
      <p class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-slate-500 dark:border-slate-700">
        Belum ada berita yang dipublikasikan.
      </p>
    ) : (
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {berita.map((b) => (
          <li class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
            <a href={`/berita/${b.slug}`} class="block">
              <SmartImage src={b.cover_url} alt={b.judul} class="aspect-[16/9] w-full object-cover transition duration-300 group-hover:scale-[1.02]" />
              <div class="space-y-2 p-4">
                {b.kategori_nama && (
                  <span class="inline-block rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-900/30 dark:text-brand-500">
                    {b.kategori_nama}
                  </span>
                )}
                <h3 class="line-clamp-2 text-base font-semibold text-slate-900 dark:text-white">
                  {b.judul}
                </h3>
                {b.ringkasan && (
                  <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-300">
                    {b.ringkasan}
                  </p>
                )}
                <div class="text-xs text-slate-400 dark:text-slate-500">
                  {b.published_at?.slice(0, 10) || ''}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
