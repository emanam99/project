---
/** Galeri foto — semua kategori, kalau diberi ?kategori=slug akan filter. */
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import SmartImage from '../../components/SmartImage.astro'
import { fetchGaleri } from '../../lib/api'

const url = new URL(Astro.request.url)
const kategori = url.searchParams.get('kategori')?.trim() || undefined
const galeri = await fetchGaleri(kategori)
---

<Layout title="Galeri" description="Dokumentasi foto kegiatan pondok pesantren.">
  <header class="mb-6">
    <h1 class="text-2xl font-bold">Galeri</h1>
    {kategori && (
      <p class="mt-1 text-sm text-slate-500">Album: {kategori}</p>
    )}
  </header>

  {(!galeri || galeri.length === 0) ? (
    <p class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-slate-500 dark:border-slate-700">
      Belum ada foto.
    </p>
  ) : (
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
      {galeri.map((g) => (
        <li class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <a href={g.gambar_url} target="_blank" rel="noopener noreferrer" title={g.judul}>
            <SmartImage src={g.gambar_url} alt={g.judul} class="aspect-square w-full object-cover" />
          </a>
          <div class="p-2 text-xs">
            <div class="line-clamp-1 font-medium">{g.judul}</div>
            {g.kategori_nama && <div class="text-slate-400">{g.kategori_nama}</div>}
          </div>
        </li>
      ))}
    </ul>
  )}
</Layout>
