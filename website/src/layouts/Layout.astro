---
/**
 * Layout utama:
 * - <ViewTransitions /> agar pindah halaman SPA-like.
 * - Navigation di-persist (transition:persist) supaya tidak flicker tiap navigasi.
 * - Slot konten utama dengan animasi slide+fade default.
 */
import { ViewTransitions } from 'astro:transitions'
import Navigation from '../components/Navigation.tsx'
import SEO from '../components/SEO.astro'
import { fetchSeo } from '../lib/api'
import { buildSeo } from '../lib/seo'
import '../styles/global.css'

export interface Props {
  title?: string | null
  description?: string | null
  ogTitle?: string | null
  ogDescription?: string | null
  ogImage?: string | null
  type?: 'website' | 'article'
  publishedTime?: string | null
  jsonLd?: Record<string, unknown> | null
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  type = 'website',
  publishedTime = null,
  jsonLd = null
} = Astro.props as Props

const globalSeo = await fetchSeo()
const siteTitle = globalSeo?.site_title || 'Pesantren'
const seo = buildSeo({
  global: globalSeo,
  pageTitle: title,
  pageDescription: description,
  pageOgTitle: ogTitle,
  pageOgDescription: ogDescription,
  pageOgImage: ogImage,
  canonical: Astro.url.pathname,
  type,
  publishedTime
})
const pathname = Astro.url.pathname
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <SEO seo={seo} jsonLd={jsonLd} faviconUrl={globalSeo?.favicon_url || null} />
    <ViewTransitions fallback="swap" />
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <Navigation client:load pathname={pathname} siteTitle={siteTitle} transition:persist="nav" />

    <main
      transition:animate="slide"
      class="md:ml-64 pb-20 md:pb-10"
    >
      <div class="mx-auto max-w-5xl px-4 py-6 md:px-8 md:py-10">
        <slot />
      </div>
    </main>
  </body>
</html>
