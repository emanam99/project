---
/**
 * SmartImage:
 * - Pakai <img> agar URL absolut dari shared hosting (/api/uploads/...) tetap bisa langsung dipakai.
 * - Jika src kosong / null → placeholder lokal /images/placeholder-pesantren.jpg.
 * - alt wajib; jika kosong dipaksa fallback ke title.
 */
type Loading = 'lazy' | 'eager'

export interface Props {
  src?: string | null
  alt?: string | null
  title?: string | null
  width?: number
  height?: number
  class?: string
  loading?: Loading
  decoding?: 'async' | 'sync' | 'auto'
}

const {
  src,
  alt,
  title,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  decoding = 'async'
} = Astro.props as Props

const PLACEHOLDER = '/images/placeholder-pesantren.jpg'
const finalSrc = src && String(src).trim() !== '' ? String(src).trim() : PLACEHOLDER
const safeAlt = (alt && alt.trim() !== '' ? alt : title || 'Foto') as string
---

<img
  src={finalSrc}
  alt={safeAlt}
  title={title || undefined}
  width={width}
  height={height}
  loading={loading}
  decoding={decoding}
  class={className}
  onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`}
/>
